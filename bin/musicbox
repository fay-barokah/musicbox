#!/usr/bin/env python3
"""musicbox — pemutar musik TUI.

Dibuat karena menu fzf di `music` berpindah-pindah layar dan tidak bisa diklik
atau di-scroll. Ini panel sungguhan ala btop: layout menyesuaikan ukuran
jendela, mouse jalan, dan warnanya mengikuti skema Caelestia.

Bagian:
  MpvPlayer  — mesin pemutar. mpv dijalankan sekali dalam mode idle lalu
               dikendalikan lewat JSON IPC. Berbeda dari `music` yang meng-exec
               mpv di depan; mode idle memungkinkan kendali penuh dari UI.
  Library    — pindai ~/Music, baca tag dengan mutagen, cache ke JSON.
  MusicBox   — aplikasi Textual.

Unduhan sengaja memanggil `music -d` alih-alih menulis ulang perintah yt-dlp:
flag di sana sudah teruji (mp3 vs opus, embed sampul/metadata, dan jebakan
file .mp3 yang isinya sebenarnya AAC). Dua salinan berarti dua tempat yang
bisa menyimpang.
"""

from __future__ import annotations

import asyncio
import json
import os
import random
import re
import shutil
import subprocess
import threading
import time
import unicodedata
from pathlib import Path

from textual.app import App, ComposeResult
from textual.binding import Binding
from textual.containers import Horizontal, Vertical
from textual.screen import ModalScreen
from textual.message import Message
from textual.reactive import reactive
from textual.widgets import (DataTable, Footer, Header, Input, Static,
                             TabbedContent, TabPane, Tree)

# ---------------------------------------------------------------- konstanta

HOME = Path.home()
MUSIC_DIR = Path(os.environ.get("MUSIC_DIR", HOME / "Music"))
STATE_DIR = HOME / ".local/share/musicbox"
LIBRARY_CACHE = STATE_DIR / "library.json"
RESUME_FILE = STATE_DIR / "resume.json"
DOWNLOADS_LOG = STATE_DIR / "downloads.json"
QUEUE_FILE = STATE_DIR / "queue.json"
PLAYLIST_DIR = STATE_DIR / "playlists"
SCHEME_FILE = HOME / ".local/state/caelestia/scheme.json"
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
MPV_SOCKET = RUNTIME / "musicbox-mpv.sock"

AUDIO_EXT = {".mp3", ".m4a", ".opus", ".flac", ".ogg", ".oga", ".wav", ".aac", ".wma"}

# Warna cadangan kalau Caelestia belum pernah menghasilkan skema.
FALLBACK = {
    "surface": "1c1c1c", "surfaceContainer": "262626", "surfaceContainerHigh": "303030",
    "onSurface": "e6e6e6", "onSurfaceVariant": "a8a8a8", "primary": "89b4fa",
    "outline": "6c6c6c", "error": "f38ba8",
}


def fmt_time(seconds: float | None) -> str:
    if not seconds or seconds < 0:
        return "--:--"
    seconds = int(seconds)
    h, rem = divmod(seconds, 3600)
    m, s = divmod(rem, 60)
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m}:{s:02d}"


# ------------------------------------------------------------------ pemutar


class MpvPlayer:
    """Bungkus mpv yang berjalan terus dalam mode idle.

    Kenapa idle: proses mpv tetap hidup di antara lagu, jadi status pemutaran
    bisa dipantau dan dikendalikan kapan saja lewat socket. Diverifikasi pada
    mpv v0.41.0 — `idle-active` merespons `true`.
    """

    def __init__(self) -> None:
        self.proc: subprocess.Popen | None = None
        self.reader: asyncio.StreamReader | None = None
        self.writer: asyncio.StreamWriter | None = None
        self.mpris = False
        self._req_id = 0
        # Bayangan playlist mpv. mpv tidak bisa ditanya lagi kalau prosesnya
        # sudah mati, jadi isinya dicatat di sini supaya bisa dipulihkan.
        self.playlist: list[str] = []
        self.loop = False
        self.radio = False
        self.restarts = 0
        self._generation = 0
        self._pending: dict[int, asyncio.Future] = {}
        self.state: dict = {
            "path": None, "title": None, "pause": True,
            "time-pos": 0.0, "duration": 0.0, "volume": 70.0,
            "playlist-pos": 0,
        }
        self.on_update = None  # callback tanpa argumen, dipanggil tiap state berubah

    @staticmethod
    def _mpris_script() -> str | None:
        """Cari plugin mpv-mpris — hanya kalau diminta lewat MUSICBOX_MPRIS=1.

        Dengan plugin ini musicbox muncul di widget media Caelestia lengkap
        dengan judul dan kendali; `Players.qml:18` bahkan menyebut mpv-mpris
        secara eksplisit. Tapi bawaannya sekarang MATI, dan itu disengaja.

        mpv-mpris 1.2 (rilis 2023) di atas mpv 0.41 sesekali membunuh mpv saat
        lagu berpindah: thread `cplugin/mpris2` menyusun sinyal PropertiesChanged
        dari string metadata yang sedang diganti mpv, GLib mendapati UTF-8 tak
        sah di `append_value_to_blob`, lalu memanggil abort(). Prosesnya jadi
        zombie dan pemutaran berhenti total di tengah album.

        Terukur di sini: 3 dari 30 perpindahan lagu gagal dengan plugin, 0 dari
        15 tanpa. Yang dikorbankan hanya kendali dari widget desktop; yang
        ditebus adalah musik yang tidak mati sendiri. Nyalakan lagi dengan
        `MUSICBOX_MPRIS=1 musicbox` kalau versi mpv-mpris di sistem sudah
        diperbaiki.
        """
        if os.environ.get("MUSICBOX_MPRIS") != "1":
            return None
        for candidate in ("/usr/lib/mpv/mpris.so", "/usr/lib/mpv-mpris/mpris.so",
                          "/usr/share/mpv/scripts/mpris.so"):
            if Path(candidate).exists():
                return candidate
        return None

    async def start(self) -> None:
        MPV_SOCKET.parent.mkdir(parents=True, exist_ok=True)
        MPV_SOCKET.unlink(missing_ok=True)
        args = ["mpv", "--idle=yes", "--no-video", "--really-quiet",
                "--volume=70", f"--input-ipc-server={MPV_SOCKET}",
                # Fallback ke `best` wajib: live stream YouTube tidak punya
                # format audio-only, jadi `bestaudio` sendirian akan gagal.
                "--ytdl-format=bestaudio/best"]
        # Keluaran audio bisa dipaksa lewat MUSICBOX_AO. Dipakai pengujian
        # (`MUSICBOX_AO=null`) supaya tidak berebut perangkat dengan musicbox
        # yang sedang benar-benar dipakai mendengarkan musik — kalau berebut,
        # mpv gagal membuka stream dan lagunya tidak jadi diputar sama sekali.
        ao = os.environ.get("MUSICBOX_AO")
        if ao:
            args.append(f"--ao={ao}")
        script = self._mpris_script()
        if script:
            args.append(f"--script={script}")
        else:
            # Menahan diri dari `--script=` saja tidak cukup. Paket mpv-mpris di
            # Arch/CachyOS memasang symlink di /etc/mpv/scripts/mpris.so, dan mpv
            # memuat isi direktori itu untuk setiap pemakaian tanpa diminta —
            # jadi plugin yang sama tetap ikut dan tetap bisa membunuh mpv.
            # `--load-scripts=no` yang benar-benar mematikannya. Terverifikasi:
            # tanpa flag ini org.mpris.MediaPlayer2.mpv tetap muncul di bus.
            args.append("--load-scripts=no")
        self.mpris = bool(script)
        self.proc = subprocess.Popen(
            args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        # Socket dibuat mpv beberapa saat setelah proses hidup.
        for _ in range(100):
            if MPV_SOCKET.exists():
                break
            await asyncio.sleep(0.05)
        # Tutup sambungan lama sebelum yang baru dipasang, kalau ini start ulang.
        if self.writer is not None:
            try:
                self.writer.close()
            except Exception:
                pass
        self.reader, self.writer = await asyncio.open_unix_connection(str(MPV_SOCKET))
        for prop in ("path", "media-title", "pause", "time-pos", "duration",
                     "volume", "playlist-pos"):
            await self._send({"command": ["observe_property", 1, prop]})
        # Tiap sambungan punya nomor generasi. Tanpa ini pembaca lama ikut hidup
        # setelah mpv dihidupkan ulang, lalu dua task berebut `readline()` pada
        # StreamReader yang sama — asyncio menolaknya, salah satu task mati, dan
        # pembaruan properti berhenti mengalir. Gejalanya persis seperti mpv yang
        # macet padahal prosesnya sehat.
        self._generation += 1
        asyncio.create_task(self._read_loop(self._generation, self.reader))

    async def ensure_alive(self) -> bool:
        """Hidupkan lagi mpv kalau prosesnya mati, di lagu dan detik yang sama.

        mpv bisa berhenti mendadak di luar kendali kita — plugin pihak ketiga
        yang memanggil abort(), OOM killer, dekoder yang menyerah. Tanpa
        penjagaan ini prosesnya tinggal jadi zombie dan aplikasi tampak macet:
        judul tetap terpampang, waktu berhenti, semua tombol diam. Gejala itu
        yang paling membingungkan, karena yang rusak justru bagian yang tak
        terlihat.

        Mengembalikan True kalau baru saja dibangkitkan, supaya pemanggil bisa
        memberi tahu pengguna.
        """
        if self.proc is None or self.proc.poll() is None:
            return False

        self.proc.wait()                      # panen zombie-nya
        playlist, loop = list(self.playlist), self.loop
        idx = int(self.state.get("playlist-pos") or 0)
        pos = float(self.state.get("time-pos") or 0.0)
        was_paused = bool(self.state.get("pause"))
        vol = float(self.state.get("volume") or 70.0)
        self.restarts += 1

        try:
            await self.start()
        except Exception:
            return False
        self.playlist, self.loop = playlist, loop

        if playlist:
            await self._send({"command": ["loadfile", playlist[0], "replace"]})
            for target in playlist[1:]:
                await self._send({"command": ["loadfile", target, "append"]})
            if loop:
                await self._send({"command": ["set_property", "loop-playlist", "inf"]})
            if 0 < idx < len(playlist):
                await self._send({"command": ["set_property", "playlist-pos", idx]})
            # Lagu perlu sempat terbuka sebelum bisa dilompati posisinya.
            if pos > 1:
                await asyncio.sleep(0.6)
                await self._send({"command": ["seek", pos, "absolute"]})
            if was_paused:
                await self._send({"command": ["set_property", "pause", True]})
        await self.set_volume_abs(vol)
        return True

    async def request(self, command: list):
        """Kirim perintah lalu tunggu jawabannya, dicocokkan lewat request_id.

        Sampai sekarang musicbox hanya menyuruh mpv dan tidak pernah bertanya.
        Membaca daftar putar butuh jawaban, dan jawaban itu datang bercampur
        dengan aliran event — tanpa dicocokkan nomornya, yang terbaca bisa jadi
        peristiwa lain yang kebetulan lewat lebih dulu.
        """
        if not self.writer:
            return None
        self._req_id += 1
        rid = self._req_id
        try:
            fut = asyncio.get_running_loop().create_future()
        except RuntimeError:
            return None
        self._pending[rid] = fut
        await self._send({"command": command, "request_id": rid})
        try:
            return await asyncio.wait_for(fut, timeout=5)
        except (asyncio.TimeoutError, asyncio.CancelledError):
            return None
        finally:
            self._pending.pop(rid, None)

    async def playlist_entries(self) -> list[dict]:
        """Isi daftar putar mpv sekarang, termasuk yang dibuka dari Mix."""
        data = await self.request(["get_property", "playlist"])
        return data if isinstance(data, list) else []

    async def play_index(self, idx: int) -> None:
        await self._send({"command": ["set_property", "playlist-pos", idx]})

    async def _send(self, payload: dict) -> None:
        if not self.writer:
            return
        self._req_id += 1
        payload.setdefault("request_id", self._req_id)
        try:
            self.writer.write((json.dumps(payload) + "\n").encode())
            await self.writer.drain()
        except (BrokenPipeError, ConnectionResetError):
            pass

    async def _read_loop(self, generation: int, reader: asyncio.StreamReader) -> None:
        while generation == self._generation:
            try:
                line = await reader.readline()
            except (ConnectionResetError, asyncio.IncompleteReadError,
                    RuntimeError, OSError):
                break
            if not line:
                break
            try:
                msg = json.loads(line)
            except json.JSONDecodeError:
                continue
            rid = msg.get("request_id")
            if rid is not None and rid in self._pending:
                fut = self._pending.get(rid)
                if fut is not None and not fut.done():
                    fut.set_result(msg.get("data"))
                continue
            if msg.get("event") == "property-change":
                name, data = msg.get("name"), msg.get("data")
                if name == "media-title":
                    self.state["title"] = data
                elif name in self.state:
                    self.state[name] = data
                if self.on_update:
                    self.on_update()

    # -- perintah ---------------------------------------------------------

    async def play(self, target: str) -> None:
        self.playlist = [target]
        self.radio = False
        await self._send({"command": ["loadfile", target, "replace"]})
        await self._send({"command": ["set_property", "pause", False]})

    async def load_paused(self, target: str, position: float = 0.0) -> None:
        """Muat lagu dalam keadaan jeda pada posisi tertentu.

        `start` diberikan sebagai opsi per-file supaya mpv langsung membuka di
        posisi itu, bukan memutar dari awal lalu melompat.
        """
        opts = {"pause": "yes"}
        if position > 1:
            opts["start"] = str(int(position))
        self.playlist = [target]
        await self._send({"command": ["loadfile", target, "replace", -1, opts]})

    async def play_radio(self, target: str) -> None:
        """Putar daftar Mix YouTube, bukan cuma lagu pertamanya.

        mpv memberi `--no-playlist` ke yt-dlp secara bawaan, jadi URL berisi
        `&list=RD…` hanya memuat satu lagu — radio yang berhenti setelah lagu
        pertama, yang justru kebalikan dari gunanya. Terukur pada satu Mix:
        1 lagu tanpa opsi ini, 275 dengan.

        Opsinya diberikan per-file, bukan ke seluruh proses mpv, supaya URL
        biasa yang kebetulan membawa `list=` tidak ikut berubah perilakunya.
        """
        self.playlist = [target]
        self.radio = True
        await self._send({"command": ["loadfile", target, "replace", -1,
                                      {"ytdl-raw-options": "yes-playlist="}]})
        await self._send({"command": ["set_property", "pause", False]})

    async def append(self, target: str) -> None:
        self.playlist.append(target)
        await self._send({"command": ["loadfile", target, "append-play"]})

    async def toggle_pause(self) -> None:
        await self._send({"command": ["cycle", "pause"]})

    async def next_track(self) -> None:
        await self._send({"command": ["playlist-next", "force"]})

    async def prev_track(self) -> None:
        await self._send({"command": ["playlist-prev", "force"]})

    async def stop(self) -> None:
        await self._send({"command": ["stop"]})

    async def seek(self, delta: int) -> None:
        await self._send({"command": ["seek", delta, "relative"]})

    async def set_loop(self, enabled: bool) -> None:
        self.loop = enabled
        await self._send({"command": ["set_property", "loop-playlist",
                                      "inf" if enabled else "no"]})

    async def seek_fraction(self, frac: float) -> None:
        """Lompat ke posisi 0..1 dari durasi. Dipakai saat bar diklik."""
        await self._send({"command": ["seek", max(0.0, min(1.0, frac)) * 100,
                                      "absolute-percent"]})

    async def set_volume(self, delta: int) -> None:
        vol = max(0, min(130, (self.state.get("volume") or 70) + delta))
        await self._send({"command": ["set_property", "volume", vol]})

    async def set_volume_abs(self, vol: float) -> None:
        await self._send({"command": ["set_property", "volume",
                                      max(0.0, min(130.0, vol))]})

    def shutdown(self) -> None:
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()
        MPV_SOCKET.unlink(missing_ok=True)


# -------------------------------------------------------------------- mpris


MPRIS_BUS = "org.mpris.MediaPlayer2.musicbox"
MPRIS_PATH = "/org/mpris/MediaPlayer2"
MPRIS_IFACE = "org.mpris.MediaPlayer2"
PLAYER_IFACE = "org.mpris.MediaPlayer2.Player"
PROPS_IFACE = "org.freedesktop.DBus.Properties"


def dbus_safe(text) -> str:
    """Bersihkan teks sebelum diserahkan ke D-Bus.

    Persis di sinilah mpv-mpris jatuh: GLib memanggil abort() begitu menerima
    string yang bukan UTF-8 sah, dan yang mati bukan cuma pengirimnya melainkan
    seluruh proses. Satu huruf yang berubah jadi tanda tanya jauh lebih murah
    daripada pemutar yang berhenti di tengah album.
    """
    return str(text or "").encode("utf-8", "replace").decode("utf-8", "replace")


class MprisService:
    """Daftarkan musicbox sendiri ke D-Bus sebagai pemutar MPRIS.

    Dengan ini musicbox muncul di widget media desktop — termasuk milik
    Caelestia — lengkap dengan judul, sampul, dan tombol, tanpa menumpang
    plugin mpv-mpris yang di sistem ini membunuh mpv saat lagu berpindah.

    Semua urusan D-Bus berjalan di thread sendiri dengan main loop GLib.
    Perubahan status ditengok berkala dari thread itu, bukan dikirim dari
    thread asyncio, karena memancarkan sinyal D-Bus lintas thread tidak aman.
    Perintah dari luar berjalan sebaliknya: dijadwalkan kembali ke loop
    asyncio, satu-satunya tempat yang boleh menyentuh socket mpv.

    Kalau python-dbus tidak ada, kelas ini diam sepenuhnya dan musicbox tetap
    berjalan seperti biasa — hanya tanpa ikon di desktop.
    """

    def __init__(self, player: "MpvPlayer", info_hook=None) -> None:
        self.player = player
        self.info_hook = info_hook or (lambda: {})
        self.aktif = False
        self._loop = None            # main loop GLib
        self._thread = None
        self._obj = None
        self._terakhir: dict = {}
        self._asyncio_loop = None

    # -- daur hidup --------------------------------------------------------

    def start(self) -> bool:
        try:
            self._asyncio_loop = asyncio.get_running_loop()
        except RuntimeError:
            self._asyncio_loop = None
        try:
            import dbus                       # noqa: F401
            import dbus.service               # noqa: F401
            from dbus.mainloop.glib import DBusGMainLoop  # noqa: F401
            from gi.repository import GLib    # noqa: F401
        except Exception:
            return False                      # tanpa pustaka D-Bus, diam saja
        self._thread = threading.Thread(target=self._serve, name="mpris",
                                        daemon=True)
        self._thread.start()
        return True

    def stop(self) -> None:
        if self._loop is not None:
            try:
                self._loop.quit()
            except Exception:
                pass
        self.aktif = False

    def _serve(self) -> None:
        import dbus
        from dbus.mainloop.glib import DBusGMainLoop
        from gi.repository import GLib
        try:
            DBusGMainLoop(set_as_default=True)
            bus = dbus.SessionBus()
            nama = dbus.service.BusName(MPRIS_BUS, bus)
            self._obj = _MprisObject(bus, self, nama)
            self.aktif = True
            # Setengah detik cukup halus untuk widget desktop dan tidak
            # membebani: yang dikirim hanya properti yang benar-benar berubah.
            GLib.timeout_add(500, self._tengok)
            self._loop = GLib.MainLoop()
            self._loop.run()
        except Exception:
            self.aktif = False

    # -- properti ----------------------------------------------------------

    def _status(self) -> str:
        st = self.player.state
        if not st.get("path"):
            return "Stopped"
        return "Paused" if st.get("pause") else "Playing"

    def metadata(self) -> dict:
        import dbus
        st = self.player.state
        info = {}
        try:
            info = self.info_hook() or {}
        except Exception:
            info = {}
        judul = info.get("title") or st.get("title") or "musicbox"
        artis = info.get("artist") or ""
        durasi = float(st.get("duration") or 0.0)
        md = {
            "mpris:trackid": dbus.ObjectPath("/org/mpris/MediaPlayer2/musicbox/lagu"),
            "mpris:length": dbus.Int64(int(durasi * 1_000_000)),
            "xesam:title": dbus.String(dbus_safe(judul)),
            "xesam:artist": dbus.Array([dbus.String(dbus_safe(artis or "—"))],
                                       signature="s"),
            "xesam:album": dbus.String(dbus_safe(info.get("album") or "")),
        }
        sampul = info.get("art")
        if sampul:
            md["mpris:artUrl"] = dbus.String(
                Path(sampul).as_uri() if not str(sampul).startswith(("http", "file"))
                else dbus_safe(sampul))
        sumber = st.get("path")
        if sumber:
            md["xesam:url"] = dbus.String(
                dbus_safe(sumber) if str(sumber).startswith("http")
                else Path(str(sumber)).as_uri())
        return md

    def props(self, iface: str) -> dict:
        import dbus
        if iface == MPRIS_IFACE:
            return {
                "CanQuit": dbus.Boolean(False),
                "CanRaise": dbus.Boolean(False),
                "HasTrackList": dbus.Boolean(False),
                "Identity": dbus.String("musicbox"),
                "DesktopEntry": dbus.String("musicbox"),
                "SupportedUriSchemes": dbus.Array(["file", "http", "https"],
                                                  signature="s"),
                "SupportedMimeTypes": dbus.Array(["audio/mpeg", "audio/ogg",
                                                  "audio/flac", "audio/mp4"],
                                                 signature="s"),
            }
        if iface == PLAYER_IFACE:
            st = self.player.state
            return {
                "PlaybackStatus": dbus.String(self._status()),
                "LoopStatus": dbus.String("Playlist" if self.player.loop else "None"),
                "Rate": dbus.Double(1.0),
                "Shuffle": dbus.Boolean(False),
                "Metadata": dbus.Dictionary(self.metadata(), signature="sv"),
                "Volume": dbus.Double(float(st.get("volume") or 70.0) / 100.0),
                "Position": dbus.Int64(int(float(st.get("time-pos") or 0.0)
                                           * 1_000_000)),
                "MinimumRate": dbus.Double(1.0),
                "MaximumRate": dbus.Double(1.0),
                "CanGoNext": dbus.Boolean(True),
                "CanGoPrevious": dbus.Boolean(True),
                "CanPlay": dbus.Boolean(True),
                "CanPause": dbus.Boolean(True),
                "CanSeek": dbus.Boolean(True),
                "CanControl": dbus.Boolean(True),
            }
        return {}

    def _tengok(self) -> bool:
        """Bandingkan dengan keadaan terakhir, kirim hanya yang berubah."""
        import dbus
        try:
            sekarang = {
                "PlaybackStatus": self._status(),
                "Volume": round(float(self.player.state.get("volume") or 70.0) / 100.0, 3),
                "_judul": str(self.metadata().get("xesam:title", "")),
                "_durasi": int(self.metadata().get("mpris:length", 0)),
            }
        except Exception:
            return True
        berubah = {k: v for k, v in sekarang.items() if self._terakhir.get(k) != v}
        if berubah:
            kirim = {}
            if "PlaybackStatus" in berubah:
                kirim["PlaybackStatus"] = dbus.String(sekarang["PlaybackStatus"])
            if "Volume" in berubah:
                kirim["Volume"] = dbus.Double(sekarang["Volume"])
            if "_judul" in berubah or "_durasi" in berubah:
                kirim["Metadata"] = dbus.Dictionary(self.metadata(), signature="sv")
            try:
                self._obj.PropertiesChanged(PLAYER_IFACE,
                                            dbus.Dictionary(kirim, signature="sv"),
                                            dbus.Array([], signature="s"))
            except Exception:
                pass
            self._terakhir = sekarang
        return True                            # terus dijadwalkan ulang

    # -- perintah dari luar -------------------------------------------------

    def command(self, nama: str, *args) -> None:
        """Jalankan perintah di loop asyncio; socket mpv hanya milik loop itu."""
        if self._asyncio_loop is None:
            return
        peta = {
            "next": lambda: self.player.next_track(),
            "prev": lambda: self.player.prev_track(),
            "playpause": lambda: self.player.toggle_pause(),
            "stop": lambda: self.player.stop(),
            "seek": lambda: self.player.seek(int(args[0]) if args else 0),
            "volume": lambda: self.player.set_volume_abs(float(args[0]) * 100.0),
        }
        buat = peta.get(nama)
        if not buat:
            return
        try:
            asyncio.run_coroutine_threadsafe(buat(), self._asyncio_loop)
        except Exception:
            pass

    def play_state(self, mau_main: bool) -> None:
        st = self.player.state
        if bool(st.get("pause")) == (not mau_main):
            return
        self.command("playpause")


def _bikin_mpris_object():
    """Definisi objek D-Bus dibuat saat dibutuhkan.

    Kelasnya mewarisi dbus.service.Object, jadi tidak bisa didefinisikan di
    level modul: musicbox harus tetap bisa dijalankan di sistem tanpa
    python-dbus, dan impor di level modul akan menggagalkannya sejak awal.
    """
    import dbus
    import dbus.service

    class _Obj(dbus.service.Object):
        def __init__(self, bus, svc, nama):
            super().__init__(nama, MPRIS_PATH)
            self.svc = svc

        @dbus.service.method(MPRIS_IFACE)
        def Raise(self):
            pass

        @dbus.service.method(MPRIS_IFACE)
        def Quit(self):
            pass

        @dbus.service.method(PLAYER_IFACE)
        def Next(self):
            self.svc.command("next")

        @dbus.service.method(PLAYER_IFACE)
        def Previous(self):
            self.svc.command("prev")

        @dbus.service.method(PLAYER_IFACE)
        def Pause(self):
            self.svc.play_state(False)

        @dbus.service.method(PLAYER_IFACE)
        def Play(self):
            self.svc.play_state(True)

        @dbus.service.method(PLAYER_IFACE)
        def PlayPause(self):
            self.svc.command("playpause")

        @dbus.service.method(PLAYER_IFACE)
        def Stop(self):
            self.svc.command("stop")

        @dbus.service.method(PLAYER_IFACE, in_signature="x")
        def Seek(self, offset):
            self.svc.command("seek", int(offset) // 1_000_000)

        @dbus.service.method(PLAYER_IFACE, in_signature="ox")
        def SetPosition(self, trackid, pos):
            st = self.svc.player.state
            sekarang = float(st.get("time-pos") or 0.0)
            self.svc.command("seek", int(int(pos) / 1_000_000 - sekarang))

        @dbus.service.method(PLAYER_IFACE, in_signature="s")
        def OpenUri(self, uri):
            pass

        @dbus.service.method(PROPS_IFACE, in_signature="ss", out_signature="v")
        def Get(self, iface, prop):
            return self.svc.props(iface).get(prop, "")

        @dbus.service.method(PROPS_IFACE, in_signature="s", out_signature="a{sv}")
        def GetAll(self, iface):
            return self.svc.props(iface)

        @dbus.service.method(PROPS_IFACE, in_signature="ssv")
        def Set(self, iface, prop, value):
            if iface == PLAYER_IFACE and prop == "Volume":
                self.svc.command("volume", float(value))

        @dbus.service.signal(PROPS_IFACE, signature="sa{sv}as")
        def PropertiesChanged(self, iface, changed, invalidated):
            pass

    return _Obj


class _MprisObject:
    """Pembungkus tipis supaya kelas D-Bus baru dibuat saat pustakanya ada."""

    def __new__(cls, bus, svc, nama):
        return _bikin_mpris_object()(bus, svc, nama)


# ------------------------------------------------------------------ library


class Library:
    """Daftar lagu di ~/Music beserta tag-nya.

    Hasil pindaian di-cache supaya start berikutnya tidak membaca ulang semua
    file. Cache dianggap basi kalau mtime direktori berubah.
    """

    def __init__(self) -> None:
        self.tracks: list[dict] = []

    def scan(self, force: bool = False) -> list[dict]:
        if not MUSIC_DIR.is_dir():
            self.tracks = []
            return self.tracks
        dir_mtime = MUSIC_DIR.stat().st_mtime
        if not force and LIBRARY_CACHE.exists():
            try:
                cached = json.loads(LIBRARY_CACHE.read_text())
                if cached.get("mtime") == dir_mtime:
                    self.tracks = cached["tracks"]
                    return self.tracks
            except (json.JSONDecodeError, KeyError, OSError):
                pass

        tracks = []
        for f in sorted(MUSIC_DIR.iterdir()):
            if not f.is_file() or f.suffix.lower() not in AUDIO_EXT:
                continue
            tracks.append(self._read_tags(f))
        self.tracks = tracks
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        LIBRARY_CACHE.write_text(json.dumps({"mtime": dir_mtime, "tracks": tracks}))
        return tracks

    @staticmethod
    def _read_tags(path: Path) -> dict:
        title, artist, dur = path.stem, "", 0.0
        try:
            from mutagen import File as MutagenFile

            m = MutagenFile(path, easy=True)
            if m is not None:
                if m.info is not None:
                    dur = float(getattr(m.info, "length", 0.0) or 0.0)
                title = (m.get("title") or [title])[0]
                artist = (m.get("artist") or [""])[0]
        except Exception:
            # Tag rusak atau format tak dikenal bukan alasan menyembunyikan
            # lagunya — tampilkan apa adanya dengan nama file.
            pass
        return {"path": str(path), "title": title, "artist": artist, "duration": dur}


# ------------------------------------------------------------------- sampul

COVER_CACHE = STATE_DIR / "covers"


def extract_cover(path: Path) -> Path | None:
    """Ambil sampul yang tertanam di file audio.

    mutagen menyimpan gambar di tempat berbeda tergantung format: APIC untuk
    ID3 (mp3), `covr` untuk MP4/M4A, dan `pictures` untuk FLAC/Opus. Ketiganya
    ditangani supaya semua file di ~/Music punya peluang menampilkan sampul.
    """
    COVER_CACHE.mkdir(parents=True, exist_ok=True)
    out = COVER_CACHE / (str(abs(hash(str(path)))) + ".png")
    if out.exists():
        return out
    try:
        from mutagen import File as MutagenFile

        audio = MutagenFile(path)
        if audio is None:
            return None
        data = None
        tags = getattr(audio, "tags", None)
        if tags is not None:
            for key in tags.keys():
                if key.startswith("APIC"):
                    data = tags[key].data
                    break
            if data is None and "covr" in tags:
                covr = tags["covr"]
                data = bytes(covr[0]) if covr else None
        if data is None:
            pics = getattr(audio, "pictures", None)
            if pics:
                data = pics[0].data
        if data is None and tags is not None and "metadata_block_picture" in tags:
            # Ogg/Opus menyimpan sampul sebagai blok Picture FLAC yang
            # di-base64 di dalam Vorbis comment — bukan APIC maupun .pictures.
            # Tanpa cabang ini semua unduhan format opus kehilangan sampulnya.
            import base64

            from mutagen.flac import Picture

            for blob in tags["metadata_block_picture"]:
                try:
                    data = Picture(base64.b64decode(blob)).data
                    break
                except Exception:
                    continue
        if not data:
            return None
        out.write_bytes(data)
        return out
    except Exception:
        return None


def aspek_gambar(path: Path) -> float | None:
    """Rasio lebar:tinggi sebuah gambar, atau None kalau tidak terbaca."""
    try:
        from PIL import Image as _PILImage

        with _PILImage.open(path) as im:
            w, h = im.size
        return (w / h) if h else None
    except Exception:
        return None


def fetch_thumbnail(video_id: str) -> Path | None:
    """Unduh thumbnail YouTube. Ukuran mq sudah cukup untuk panel selebar 36."""
    COVER_CACHE.mkdir(parents=True, exist_ok=True)
    out = COVER_CACHE / f"yt-{video_id}.jpg"
    if out.exists():
        return out
    try:
        subprocess.run(
            ["curl", "-sL", "--max-time", "15", "-o", str(out),
             f"https://i.ytimg.com/vi/{video_id}/mqdefault.jpg"],
            check=True, capture_output=True, timeout=20)
        return out if out.exists() and out.stat().st_size > 0 else None
    except (OSError, subprocess.SubprocessError):
        return None


# ------------------------------------------------------------------ youtube


def yt_search(query: str, limit: int = 20) -> list[dict]:
    """Cari lagu di YouTube lewat yt-dlp.

    Format --print memakai TAB SUNGGUHAN: `yt-dlp --print` tidak menafsirkan
    "\\t" dan akan mencetaknya sebagai dua huruf literal. Sama persis dengan
    pick_video() di skrip `music`.
    """
    tab = "\t"
    # view_count ikut terbawa oleh --flat-playlist, jadi gratis. like_count
    # TIDAK: mengambilnya menuntut ekstraksi penuh tiap video, sekitar lima
    # detik per judul — dua menit hanya untuk memberi angka pada satu layar
    # hasil. Likes diambil belakangan, hanya untuk baris yang disorot.
    fmt = tab.join(("%(id)s", "%(duration>%H:%M:%S)s", "%(uploader).24s",
                    "%(view_count)s", "%(title).80s"))
    try:
        out = subprocess.run(
            ["yt-dlp", "--skip-download", "--no-warnings", "--flat-playlist",
             "--print", fmt, f"ytsearch{limit}:{query}"],
            capture_output=True, text=True, timeout=180,
        ).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    results = []
    for line in out.splitlines():
        parts = line.split(tab)
        if len(parts) == 5:
            results.append({"id": parts[0], "duration": parts[1],
                            "uploader": parts[2], "views": parts[3],
                            "title": parts[4]})
    return results


def rekomendasi_dari(benih: list[dict], sudah_punya: set[str],
                     per_benih: int = 12) -> list[dict]:
    """Kumpulkan calon lagu dari Mix YouTube milik lagu-lagu yang disukai.

    Bukan algoritma rekomendasi sungguhan, dan tidak berpura-pura begitu:
    daftar Mix adalah "yang menyukai ini biasanya juga mendengar itu" versi
    YouTube. Yang sudah ada di library atau di daftar suka dibuang supaya
    hasilnya benar-benar berisi hal baru.
    """
    tab = "\t"
    fmt = tab.join(("%(id)s", "%(duration>%H:%M:%S)s", "%(uploader).24s",
                    "%(view_count)s", "%(title).80s"))
    keluar: list[dict] = []
    terlihat: set[str] = set()
    for lagu in benih:
        target = str(lagu.get("target", ""))
        vid = ""
        for bagian in target.split("?", 1)[-1].split("&"):
            if bagian.startswith("v="):
                vid = bagian[2:]
                break
        if not vid:
            continue
        try:
            out = subprocess.run(
                ["yt-dlp", "--skip-download", "--no-warnings", "--flat-playlist",
                 "--playlist-end", str(per_benih), "--print", fmt,
                 yt_radio_url(vid)],
                capture_output=True, text=True, timeout=120).stdout
        except (OSError, subprocess.TimeoutExpired):
            continue
        for baris in out.splitlines():
            bagian = baris.split(tab)
            if len(bagian) != 5:
                continue
            if bagian[0] == vid or bagian[0] in terlihat:
                continue
            if bagian[4].strip().lower() in sudah_punya:
                continue
            terlihat.add(bagian[0])
            keluar.append({"id": bagian[0], "duration": bagian[1],
                           "uploader": bagian[2], "views": bagian[3],
                           "title": bagian[4]})
    # Yang paling banyak ditonton lebih dulu: dari daftar rekomendasi, itu
    # tebakan paling aman untuk lagu yang belum pernah didengar.
    def kunci(r):
        try:
            return -float(r["views"])
        except ValueError:
            return 0.0
    return sorted(keluar, key=kunci)


def yt_likes(video_id: str) -> tuple[str, str]:
    """Ambil jumlah suka satu video. Lambat — panggil hanya saat dibutuhkan."""
    try:
        out = subprocess.run(
            ["yt-dlp", "--skip-download", "--no-warnings",
             "--print", "%(like_count)s", yt_url(video_id)],
            capture_output=True, text=True, timeout=60,
        ).stdout.strip().splitlines()
        return video_id, (out[0] if out else "")
    except (OSError, subprocess.TimeoutExpired):
        return video_id, ""


def fmt_count(nilai) -> str:
    """1234567 -> 1,2 jt. Angka mentah sulit dibandingkan sekilas."""
    try:
        n = float(str(nilai).replace(",", ""))
    except (TypeError, ValueError):
        return "—"
    for batas, akhiran in ((1e9, " M"), (1e6, " jt"), (1e3, " rb")):
        if n >= batas:
            return f"{n / batas:.1f}".replace(".", ",") + akhiran
    return str(int(n))


# Baris angka mentah dari --progress-template di `music`:
#   MBPROG|<terunduh>|<total>|<perkiraan total>|<byte per detik>|<sisa detik>
# Nilai yang belum diketahui datang sebagai "NA".
DL_TEMPLATE = re.compile(r"MBPROG\|(\S*)\|(\S*)\|(\S*)\|(\S*)\|(\S*)")

# Cadangan untuk `music` versi lama yang belum mengirim MBPROG:
#   [download]  45.2% of    3.85MiB at    1.20MiB/s ETA 00:02
DL_PROGRESS = re.compile(
    r"\[download\]\s+([\d.]+)%\s+of\s+~?\s*(\S+)"
    r"(?:\s+at\s+(\S+))?(?:\s+ETA\s+(\S+))?")


def _angka(teks: str) -> float | None:
    try:
        nilai = float(teks)
    except (TypeError, ValueError):
        return None
    return nilai


def fmt_bytes(jumlah: float | None) -> str:
    if not jumlah:
        return ""
    for satuan in ("B", "KiB", "MiB", "GiB"):
        if jumlah < 1024 or satuan == "GiB":
            return f"{jumlah:.1f}{satuan}"
        jumlah /= 1024
    return ""


def fmt_eta(detik: float | None) -> str:
    if detik is None or detik < 0:
        return ""
    detik = int(detik)
    if detik >= 3600:
        return f"{detik // 3600}:{detik % 3600 // 60:02d}:{detik % 60:02d}"
    return f"{detik // 60}:{detik % 60:02d}"


def parse_progress(line: str, entry: dict) -> bool:
    """Baca satu baris keluaran unduhan ke dalam entry. True kalau ada isinya."""
    m = DL_TEMPLATE.search(line)
    if m:
        terunduh, total, perkiraan, laju, sisa = (
            _angka(m.group(i)) for i in range(1, 6))
        besar = total or perkiraan
        if besar and terunduh is not None:
            entry["percent"] = max(0.0, min(100.0, terunduh / besar * 100.0))
        entry["size"] = fmt_bytes(besar)
        entry["speed"] = f"{fmt_bytes(laju)}/s" if laju else ""
        entry["eta"] = fmt_eta(sisa)
        return True
    m = DL_PROGRESS.search(line)
    if m:
        entry["percent"] = float(m.group(1))
        entry["size"] = m.group(2)
        entry["speed"] = "" if (m.group(3) or "") == "Unknown" else (m.group(3) or "")
        entry["eta"] = "" if (m.group(4) or "") == "Unknown" else (m.group(4) or "")
        return True
    return False


def progress_cell(entry: dict, width: int = 20) -> str:
    """Sel progres bergaya pacman: bar, persen, ukuran, kecepatan, sisa waktu.

    Kurung siku sengaja tidak dipakai sebagai bingkai bar. DataTable merender
    isinya sebagai markup Rich, dan "[####----]" ditelan mentah-mentah sebagai
    tag — barnya hilang sama sekali dari layar padahal datanya ada.

    Unduhan yang sudah selesai cukup menampilkan statusnya; bar penuh yang
    tertinggal hanya menyita lebar tanpa memberi tahu apa pun.
    """
    if entry.get("status") != "berjalan":
        return str(entry.get("status", "?"))
    pct = float(entry.get("percent") or 0.0)
    penuh = int(width * min(pct, 100.0) / 100.0)
    bar = "━" * penuh + "─" * (width - penuh)
    bagian = [f"{bar} {pct:5.1f}%"]
    for kunci, awalan in (("size", ""), ("speed", ""), ("eta", "sisa ")):
        nilai = entry.get(kunci)
        if nilai:
            bagian.append(f"{awalan}{nilai}")
    return "  ".join(bagian)


def yt_url(video_id: str) -> str:
    return f"https://www.youtube.com/watch?v={video_id}"


def yt_radio_url(video_id: str) -> str:
    """Playlist Mix YouTube — rekomendasi berantai, ratusan lagu."""
    return f"https://www.youtube.com/watch?v={video_id}&list=RD{video_id}"


