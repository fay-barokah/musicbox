        self.image_ok = True
        self.downloads: list[dict] = []
        self.queue: list[dict] = []
        self.playlists: dict[str, list] = {}
        self._scheme_mtime = 0.0

    # -- tema -------------------------------------------------------------

    def get_css_variables(self) -> dict[str, str]:
        """Suntikkan palet Caelestia sebagai variabel CSS Textual.

        Dipakai lewat $cae-* di CSS di atas. Textual memanggil ini ulang saat
        refresh_css(), jadi ganti wallpaper cukup memicu refresh tanpa restart.
        """
        variables = super().get_css_variables()
        c = load_scheme()

        def col(key: str, fallback: str) -> str:
            return "#" + (c.get(key) or FALLBACK.get(key) or fallback)

        variables.update({
            "cae-surface": col("surface", "1c1c1c"),
            "cae-container": col("surfaceContainer", "262626"),
            "cae-container-high": col("surfaceContainerHigh", "303030"),
            "cae-on-surface": col("onSurface", "e6e6e6"),
            "cae-on-variant": col("onSurfaceVariant", "a8a8a8"),
            "cae-primary": col("primary", "89b4fa"),
            "cae-outline": col("outline", "6c6c6c"),
            "cae-error": col("error", "f38ba8"),
        })
        return variables

    def _watch_scheme(self) -> None:
        try:
            mtime = SCHEME_FILE.stat().st_mtime
        except OSError:
            return
        if mtime != self._scheme_mtime:
            self._scheme_mtime = mtime
            self.refresh_css()

    # -- susunan ----------------------------------------------------------

    def compose(self) -> ComposeResult:
        yield FixedHeader(show_clock=True)
        with Vertical():
            with Horizontal(id="main"):
                with TabbedContent(id="tabs"):
                    with TabPane(_("Library"), id="tab-lib"):
                        yield DataTable(id="library", cursor_type="row", zebra_stripes=False)
                    with TabPane(_("Search"), id="tab-yt"):
                        yield Input(placeholder=_("search YouTube, then press Enter…"),
                                    id="yt-input")
                        # Status pencarian ditulis di sini, bukan sebagai toast
                        # di pojok: pencarian makan belasan detik dan mata
                        # pengguna sedang menatap area hasil, bukan pojok layar.
                        yield Static(id="hasil-status")
                        yield DataTable(id="results", cursor_type="row", zebra_stripes=False)
                    with TabPane(_("Queue"), id="tab-queue"):
                        yield DataTable(id="queue", cursor_type="row",
                                        zebra_stripes=False)
                    with TabPane(_("Albums"), id="tab-pl"):
                        yield Tree("album", id="pltree")  # auto_expand dimatikan di on_mount
                    with TabPane(_("Liked"), id="tab-liked"):
                        yield Static(id="liked-status")
                        yield DataTable(id="liked", cursor_type="row",
                                        zebra_stripes=False)
                    with TabPane(_("Radio"), id="tab-radio"):
                        yield Static(id="radio-status")
                        yield DataTable(id="radio", cursor_type="row",
                                        zebra_stripes=False)
                    with TabPane(_("Downloads"), id="tab-dl"):
                        yield DataTable(id="downloads", cursor_type="row",
                                        zebra_stripes=False)
                with Vertical(id="info"):
                    yield Static(id="cover")
                    yield Static(id="info-text")
                    # Aksi khusus LAGU tinggal di sini, terpisah dari bar bawah
                    # yang khusus kendali PEMUTARAN. Sebelumnya keduanya
                    # bercampur di footer dan sulit dibedakan mana yang mana.
                    yield Vertical(id="song-actions")
            yield CavaBars(id="cava")
            yield NowPlaying()
        # Palette bawaan Textual dimatikan. Isinya perintah internal framework
        # — Maximize, Screenshot, Theme, Keys — bukan perintah musicbox, dan ia
        # menjadi permukaan keempat yang menawarkan hal-hal yang tidak ada
        # hubungannya dengan memutar musik. Setelan dan daftar pintasan sudah
        # menampung semuanya.
        yield Footer(show_command_palette=False)

    async def on_mount(self) -> None:
        table = self.query_one("#library", DataTable)
        table.add_columns(_("Title"), _("Artist"), _("Duration"))
        self.query_one("#results", DataTable).add_columns(
            _("Title"), _("Channel"), _("Duration"), _("Views"))
        self.query_one("#downloads", DataTable).add_columns(
            _("Title"), _("Format"), _("Progress"), _("Time"))
        self.query_one("#radio", DataTable).add_columns("#", _("Title"))
        self.query_one("#liked", DataTable).add_columns(_("Title"), _("Source"))
        self.query_one("#queue", DataTable).add_columns("#", _("Title"), _("Source"))
        # Enter pada node album jangan ikut melipatnya: album yang menutup
        # membuat pemutaran terlihat seperti tidak terjadi apa-apa.
        self.query_one("#pltree", Tree).auto_expand = False
        self.load_downloads()
        self.load_queue()
        self.load_playlists()
        self.load_liked()
        self.load_library()
        self._status_hasil(f"{_('type above and press Enter')}  ·  "
                           f"m {_('load more')}  ·  o {_('sort by views')}")

        await self.player.start()
        self.player.on_update = self._schedule_refresh

        # musicbox mendaftar sendiri ke D-Bus. Plugin mpv-mpris sengaja tidak
        # dipakai (lihat MpvPlayer._mpris_script) — ikon di widget media desktop
        # tetap ada, tanpa proses pemutar yang bisa ikut mati bersamanya.
        # Kalau plugin lama sengaja dinyalakan lewat MUSICBOX_MPRIS=1, layanan
        # ini mengalah: dua pendaftar sekaligus hanya menghasilkan dua pemutar
        # kembar di widget desktop.
        if not self.player.mpris:
            self.mpris = MprisService(self.player, self.now_playing_info)
            self.mpris.start()

        await self.restore_resume()

        self.set_interval(0.5, self.refresh_now_playing)
        self.set_interval(2.0, self._watch_scheme)
        self.set_interval(1.0, self._watch_player)
        self.set_interval(0.5, self._tick_downloads)
        try:
            self._scheme_mtime = SCHEME_FILE.stat().st_mtime
        except OSError:
            pass

    def _schedule_refresh(self) -> None:
        # Dipanggil dari task pembaca IPC; jadwalkan di loop UI.
        self.call_later(self.refresh_now_playing)

    def action_bahasa(self) -> None:
        """Ganti bahasa antarmuka. Inggris jadi bawaan supaya bisa dipakai siapa saja."""
        global _BAHASA
        baru = "id" if _BAHASA == "en" else "en"
        simpan_bahasa(baru)
        self.notify("Language: English — restart musicbox to apply everywhere"
                    if baru == "en" else
                    "Bahasa: Indonesia — buka ulang musicbox agar menyeluruh",
                    timeout=6)
        self.refresh_liked_table()
        self.load_library()

    def action_settings(self) -> None:
        self.push_screen(SettingsScreen())

    def action_help(self) -> None:
        """Alias lama untuk Setelan, kategori Kontrol.

        Tidak lagi punya tombol sendiri: daftar pintasan adalah salah satu
        kategori di dalam Setelan, bukan layar terpisah yang isinya sama.
        """
        self.push_screen(SettingsScreen(kategori="Controls"))

    def action_zoom_in(self) -> None:
        self._zoom(1)

    def action_zoom_out(self) -> None:
        self._zoom(-1)

    def _zoom(self, arah: int) -> None:
        """Perbesar/perkecil kerapatan tampilan.

        Ukuran huruf sesungguhnya milik terminal, bukan aplikasi: foot tidak
        menyediakan escape sequence untuk mengubahnya, jadi musicbox tidak
        mungkin melakukannya dari dalam. Yang bisa diatur adalah kerapatan —
        tinggi sampul, jumlah batang visualizer, dan padding — yang membuat
        tampilan terasa lebih lapang atau lebih padat.

        Untuk huruf yang benar-benar membesar, foot sudah menyediakannya:
        Ctrl+plus, Ctrl+minus, Ctrl+0, dan Ctrl+scroll.
        """
        self.zoom = max(0, min(2, self.zoom + arah))
        nama = ("padat", "normal", "lapang")[self.zoom]
        for i in range(3):
            self.set_class(i == self.zoom, f"zoom-{i}")
        self._fit_info_panel()
        self.notify(f"tampilan: {nama}  ·  "
                    "Ctrl+plus / Ctrl+minus mengubah ukuran huruf terminal",
                    timeout=6)

    # -- lagu disukai ------------------------------------------------------

    def load_liked(self) -> None:
        try:
            self.liked = json.loads(LIKED_FILE.read_text())
        except (OSError, json.JSONDecodeError):
            self.liked = []
        self.refresh_liked_table()

    def save_liked(self) -> None:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        try:
            LIKED_FILE.write_text(json.dumps(self.liked, indent=1))
        except OSError:
            pass

    def refresh_liked_table(self) -> None:
        try:
            tabel = self.query_one("#liked", DataTable)
            status = self.query_one("#liked-status", Static)
        except Exception:
            return
        tabel.clear()
        for lagu in self.liked:
            tabel.add_row(lagu.get("title", "?"), lagu.get("source", "—"))
        status.update(f"{len(self.liked)} {_('liked songs')}  ·  "
                      f"[dim]l {_('like')} · u {_('unlike')} · V {_('recommend')}[/dim]"
                      if self.liked else
                      f"[dim]{_('press l on any song to like it.')}[/dim]")

    def action_like(self) -> None:
        """Sukai lagu yang disorot, atau yang sedang berbunyi."""
        lagu = self._selected_song()
        if not lagu:
            st = self.player.state
            if st.get("path"):
                info = self.now_playing_info()
                lagu = {"title": info.get("title") or st.get("title") or "?",
                        "target": st["path"],
                        "source": "youtube" if str(st["path"]).startswith("http")
                                  else "lokal"}
        if not lagu:
            self.notify("sorot lagu dulu", timeout=3)
            return
        if any(x.get("target") == lagu.get("target") for x in self.liked):
            self.notify("sudah ada di daftar suka", timeout=2)
            return
        self.liked.insert(0, {"title": lagu.get("title", "?"),
                              "target": lagu.get("target", ""),
                              "source": lagu.get("source", "lokal")})
        self.save_liked()
        self.refresh_liked_table()
        self.notify(f"♥ disukai ({len(self.liked)})", timeout=2)

    def action_unlike(self) -> None:
        try:
            idx = self.query_one("#liked", DataTable).cursor_row
        except Exception:
            return
        if 0 <= idx < len(self.liked):
            hilang = self.liked.pop(idx)
            self.save_liked()
            self.refresh_liked_table()
            self.notify(f"dibuang: {hilang.get('title', '?')[:28]}", timeout=3)

    def action_rekomendasi(self) -> None:
        """Susun rekomendasi dari lagu-lagu yang disukai.

        Ini bukan algoritma sungguhan dan tidak berpura-pura begitu: yang
        dipakai adalah daftar Mix YouTube dari lagu-lagu yang disukai, lalu
        dibuang yang sudah ada di library maupun di daftar suka. Hasilnya
        "orang yang menyukai ini biasanya juga mendengar itu" — cukup berguna,
        dan jujur tentang dari mana asalnya.
        """
        if not self.liked:
            self.notify("sukai beberapa lagu dulu", timeout=4)
            return
        benih = [x for x in self.liked if str(x.get("target", "")).startswith("http")]
        if not benih:
            self.notify("rekomendasi butuh lagu dari YouTube", timeout=4)
            return
        acak = random.sample(benih, min(3, len(benih)))
        punya = {Path(t["path"]).stem.lower() for t in self.library.tracks}
        punya |= {x.get("title", "").lower() for x in self.liked}
        self._query = "rekomendasi dari lagu yang kamu sukai"
        self._mencari = True
        self._status_hasil("menyusun rekomendasi dari "
                           f"{len(acak)} lagu yang kamu sukai…")
        self.query_one("#tabs").active = "tab-yt"
        self.run_worker(lambda: rekomendasi_dari(acak, punya), thread=True,
                        name="ytsearch", group="yt", exit_on_error=False)

    async def action_radio_panel(self) -> None:
        """Buka daftar lagu yang akan diputar radio berikutnya."""
        self.query_one("#tabs").active = "tab-radio"
        await self.refresh_radio()

    async def refresh_radio(self) -> None:
        """Baca daftar putar mpv dan tampilkan yang belum diputar.

        Daftar Mix berisi ratusan judul; yang berguna adalah yang masih di
        depan. Yang sudah lewat cuma menambah gulungan tanpa memberi tahu apa
        pun soal apa yang akan terdengar berikutnya.
        """
        try:
            tabel = self.query_one("#radio", DataTable)
            status = self.query_one("#radio-status", Static)
        except Exception:
            return
        if not self.player.radio:
            tabel.clear()
            status.update(self.PETUNJUK["radio"]())
            return
        status.update(_("loading radio list…"))
        entri = await self.player.playlist_entries()
        self.radio_list = entri
        tabel.clear()
        sekarang = next((i for i, e in enumerate(entri) if e.get("current")), 0)
        for i, e in enumerate(entri):
            judul = e.get("title") or Path(str(e.get("filename", "?"))).name
            tanda = "▶ " if i == sekarang else ("  " if i > sekarang else "· ")
            tabel.add_row(str(i + 1), tanda + str(judul))
        status.update(f"[b]Radio[/b] · {len(entri)} {_('songs')} · "
                      f"{_('now at')} {sekarang + 1}"
                      f"  [dim]{_('enter jumps to a song')}[/dim]")
        if entri:
            tabel.move_cursor(row=min(sekarang, len(entri) - 1))

    def _sync_radio_button(self) -> None:
        try:
            btn = self.query_one("#btn-radio", TransportButton)
        except Exception:
            return
        aktif = bool(self.player.radio)
        btn.set_class(aktif, "on")
        btn.set_class(not aktif, "off")

    def action_player(self) -> None:
        """Buka halaman pemutar penuh dengan lirik."""
        if not self.player.state.get("path"):
            self.notify("belum ada yang diputar", timeout=3)
            return
        self.push_screen(PlayerScreen())

    def _arg_lirik(self) -> tuple[str, str, float]:
        """Argumen baku untuk mencari lirik lagu yang sedang berbunyi.

        Dirakit di satu tempat supaya kunci simpanannya selalu sama dari mana
        pun dipanggil. Kalau argumennya berbeda sedikit saja, hasil yang sudah
        tersimpan tidak akan pernah ditemukan lagi dan liriknya diminta ulang
        selamanya.
        """
        st = self.player.state
        path = st.get("path")
        mentah = st.get("title") or (Path(str(path)).stem if path else "")
        artis = ""
        if path and not str(path).startswith("http"):
            lagu = next((x for x in self.library.tracks
                         if x["path"] == str(path)), None)
            if lagu:
                mentah = lagu["title"] or mentah
                artis = lagu.get("artist") or ""
        return mentah, artis, float(st.get("duration") or 0.0)

    def minta_lirik(self, layar=None) -> None:
        """Ambil lirik lagu yang sedang berbunyi, di latar belakang."""
        judul, artis, durasi = self._arg_lirik()
        if not judul:
            return
        self._layar_lirik = layar
        self.run_worker(lambda: fetch_lyrics(judul, artis, durasi), thread=True,
                        name="lyrics", group="lyrics", exit_on_error=False)

    def _tandai_lirik(self) -> None:
        """Cari tahu ketersediaan lirik lagu ini, diam-diam, untuk penanda ♪."""
        judul, artis, durasi = self._arg_lirik()
        if not judul or lyrics_cached(judul, artis, durasi) is not None:
            return                     # kosong, atau sudah pernah dicari
        self.run_worker(lambda: (fetch_lyrics(judul, artis, durasi), "tandai"),
                        thread=True, name="lyrmark", group="lyrics",
                        exit_on_error=False)

    def now_playing_info(self) -> dict:
        """Keterangan lagu yang sedang berbunyi, untuk widget media desktop.

        Hasilnya disimpan per lagu. Pengintai MPRIS memanggil ini dua kali tiap
        detik, dan mengekstrak sampul sesering itu berarti membaca ulang berkas
        audio terus-menerus tanpa alasan.
        """
        st = self.player.state
        path = st.get("path")
        if not path:
            return {}
        if self._np_cache.get("path") == path:
            return self._np_cache["info"]
        mentah = st.get("title") or Path(str(path)).stem
        info: dict = {"title": mentah, "mentah": mentah}
        try:
            if str(path).startswith("http"):
                vid = ""
                for bagian in str(path).split("?", 1)[-1].split("&"):
                    if bagian.startswith("v="):
                        vid = bagian[2:]
                        break
                if vid:
                    gambar = fetch_thumbnail(vid)
                    if gambar:
                        info["art"] = str(gambar)
            else:
                p = Path(str(path))
                lagu = next((x for x in self.library.tracks
                             if x["path"] == str(p)), None)
                if lagu:
                    info["title"] = lagu["title"] or info["title"]
                    info["artist"] = lagu.get("artist") or ""
                sampul = extract_cover(p)
                if sampul:
                    info["art"] = str(sampul)
        except Exception:
            pass

        # Artis dan judul yang rapi bukan sekadar demi enak dilihat: widget
        # media desktop memakai keduanya untuk mencari liriknya SENDIRI
        # (Caelestia memanggil Lyrics.setTrack(artis, judul, album, durasi)).
        # Judul YouTube mentah dengan artis "—" membuat pencarian itu pasti
        # gagal, dan panel liriknya selalu kosong.
        if not info.get("artist"):
            tebak_artis, tebak_judul = bersihkan_judul(info["title"])
            if tebak_artis:
                info["artist"] = tebak_artis
            if tebak_judul:
                info["title"] = tebak_judul
        # Kalau lirik untuk lagu ini sudah pernah ketemu, pakai nama resmi dari
        # basis datanya — itu ejaan yang paling mungkin dikenali orang lain.
        try:
            simpan = fetch_lyrics_cached_only(*self._arg_lirik())
            if simpan and simpan.get("ada"):
                info["title"] = simpan.get("judul") or info["title"]
                info["artist"] = simpan.get("artis") or info.get("artist", "")
        except Exception:
            pass

        self._np_cache = {"path": path, "info": info}
        return info

    async def _watch_player(self) -> None:
        """Jaga supaya mpv yang mati tidak berubah jadi aplikasi yang membeku."""
        try:
            revived = await self.player.ensure_alive()
        except Exception:
            return
        if revived:
            self.notify("mpv berhenti mendadak — pemutaran disambung kembali",
                        severity="warning", timeout=5)

    # -- data -------------------------------------------------------------

    def load_library(self, force: bool = False) -> None:
        table = self.query_one("#library", DataTable)
        table.clear()
        tracks = self.library.scan(force=force)
        for t in tracks:
            table.add_row(self._label_library(t, self._marked_path),
                          t["artist"] or "—", fmt_time(t["duration"]))
        self.sub_title = f"library — {len(tracks)} lagu"
        if not tracks:
            self.notify(f"{MUSIC_DIR} kosong. Unduh dengan: music -d \"judul\"",
                        severity="warning", timeout=8)

    def _label_library(self, t: dict, path: str | None) -> str:
        """Label satu baris library: penanda berbunyi, penanda lirik, lalu judul.

        Keduanya menempati kolom yang sama, jadi harus dirakit di satu tempat.
        Sebelumnya penanda ▶ ditulis terpisah dan menimpa penanda ♪ setiap kali
        lagu berganti — tanda lirik hilang tepat saat lagunya mulai berbunyi.

        ♪ hanya untuk lagu yang liriknya sudah terbukti ada. Yang belum pernah
        dicari dibiarkan polos: janji yang belum tentu ditepati lebih
        mengganggu daripada diam.
        """
        kunci = t["path"]
        if kunci not in self._lyr_mark:
            self._lyr_mark[kunci] = bool(
                lyrics_cached(t["title"], t["artist"] or "", t["duration"]))
        main = "▶ " if kunci == path else "  "
        return main + ("♪ " if self._lyr_mark[kunci] else "  ") + t["title"]

    def _mark_now_playing(self, path: str | None) -> None:
        """Tandai baris yang sedang berbunyi di semua daftar.

        Tanpa ini posisi pemutaran hanya terbaca di bar bawah — saat album
        berisi banyak lagu, tidak ada cara melihat sedang di lagu mana.
        """
        marker = "▶ "
        try:
            table = self.query_one("#library", DataTable)
            for i, t in enumerate(self.library.tracks):
                table.update_cell_at((i, 0), self._label_library(t, path),
                                     update_width=False)
        except Exception:
            pass
        try:
            table = self.query_one("#queue", DataTable)
            for i, q in enumerate(self.queue):
                label = (marker if q.get("target") == path else "  ") + q.get("title", "?")
                table.update_cell_at((i, 1), label, update_width=False)
        except Exception:
            pass
        try:
            tree = self.query_one("#pltree", Tree)
            for node in tree.root.children:
                for leaf in node.children:
                    it = (leaf.data or {}).get("item") or {}
                    mark = marker if it.get("target") == path else "  "
                    leaf.set_label(mark + it.get("title", "?"))
        except Exception:
            pass

    def refresh_now_playing(self) -> None:
        st = self.player.state
        # Penanda hanya digambar ulang saat lagunya benar-benar berganti,
        # bukan tiap setengah detik.
        path = st.get("path")
        if path != self._marked_path:
            self._marked_path = path
            self._mark_now_playing(path)
            self._np_cache = {}
            self._tandai_lirik()
            self._sync_radio_button()
        title = st.get("title") or _("nothing playing")
        if st.get("pause") and st.get("path"):
            title = f"⏸  {title}"
        elif st.get("path"):
            title = f"▶  {title}"
        # Timer 0,5 detik ini terus berdetak sampai aplikasi benar-benar mati,
        # termasuk sesaat setelah widget dilepas saat keluar. Tanpa penjaga di
        # sini query_one melempar NoMatches dan aplikasi crash ketika ditutup.
        try:
            self.query_one("#np-title", Static).update(title)
            pos = st.get("time-pos") or 0.0
            dur = st.get("duration") or 0.0
            self.query_one("#np-elapsed", Static).update(fmt_time(pos))
            self.query_one("#np-total", Static).update(fmt_time(dur))
            self.query_one("#np-bar", SeekBar).position = (pos / dur) if dur else 0.0
        # Volume disinkronkan dari mpv, bukan hanya diset saat diklik — tanpa
        # ini bar-nya tidak pernah bergerak walau volumenya benar-benar berubah
        # (mis. lewat tombol +/- atau saat mpv baru mulai).
            self.query_one("#vol-bar", VolumeBar).level = (st.get("volume") or 0) / 130.0
        except Exception:
            return

    async def on_seek_bar_seek(self, message: SeekBar.Seek) -> None:
        await self.player.seek_fraction(message.fraction)

    # -- aksi -------------------------------------------------------------

    # -- pencarian YouTube -------------------------------------------------

    async def on_input_submitted(self, event: Input.Submitted) -> None:
        query = event.value.strip()
        if not query:
            return
        self._query = query
        self._limit = 20
        self._jalankan_pencarian()

    def _jalankan_pencarian(self) -> None:
        """Mulai pencarian dan perlihatkan bahwa ia sedang berjalan.

        Toast kecil di pojok terlalu mudah terlewat untuk sesuatu yang memakan
        belasan detik. Statusnya ditulis di area hasil, tempat mata sudah
        menunggu jawabannya.
        """
        q, n = self._query, self._limit
        self._mencari = True
        self._status_hasil(f"{_('searching')} “{q}”… ({n} {_('top results')})")
        self.query_one("#tabs").active = "tab-yt"
        # yt-dlp butuh belasan detik; dijalankan di thread supaya UI tidak beku.
        self.run_worker(lambda: yt_search(q, limit=n), thread=True,
                        name="ytsearch", group="yt", exit_on_error=False)

    def _status_hasil(self, teks: str) -> None:
        self.query_one("#hasil-status", Static).update(teks)

    def action_more_results(self) -> None:
        """Muat lebih banyak hasil untuk kueri yang sama."""
        if not self._query:
            self.notify("cari sesuatu dulu", timeout=3)
            return
        if self._mencari:
            return
        self._limit = min(self._limit + 20, 100)
        self._jalankan_pencarian()

    def action_sort_results(self) -> None:
        """Ganti urutan hasil: bawaan YouTube ↔ paling banyak ditonton."""
        if not self.results:
            self.notify("belum ada hasil", timeout=3)
            return
        self.sort_views = not self.sort_views
        self.refresh_results_table()
        self.notify("urut: terbanyak ditonton" if self.sort_views
                    else "urut: relevansi", timeout=3)

    def refresh_results_table(self) -> None:
        table = self.query_one("#results", DataTable)
        table.clear()
        if self.sort_views:
            def kunci(r):
                try:
                    return -float(str(r.get("views", "")).replace(",", ""))
                except ValueError:
                    return 0.0
            self.results = sorted(self.results, key=kunci)
        for r in self.results:
            # ⭳ menandai lagu yang berkasnya sudah ada, supaya tidak perlu
            # membuka panel kanan cuma untuk tahu.
            tanda = "⭳ " if self.sudah_diunduh(r) else "  "
            table.add_row(tanda + r["title"], r["uploader"], r["duration"],
                          fmt_count(r.get("views")))

    def on_worker_state_changed(self, event) -> None:
        from textual.worker import WorkerState

        if event.state is not WorkerState.SUCCESS:
            return
        if event.worker.name == "thumb":
            vid, path = event.worker.result or (None, None)
            # Abaikan kalau kursor sudah pindah ke lagu lain sejak unduhan mulai.
            cur = self._selected_result()
            if path and cur and cur["id"] == vid:
                self.show_cover(path)
            return
        if event.worker.name == "lyrics":
            layar = getattr(self, "_layar_lirik", None)
            if layar is not None and layar.is_running:
                try:
                    layar.query_one("#player-lirik", LyricsView).set_lyrics(
                        event.worker.result or {})
                except Exception:
                    pass
            return
        if event.worker.name == "lyrmark":
            # Penanda ♪ menyusul begitu ketersediaan liriknya diketahui.
            self._lyr_mark.clear()
            self.load_library()
            return
        if event.worker.name == "likes":
            vid, jumlah = event.worker.result or (None, "")
            cur = self._selected_result()
            if cur and cur["id"] == vid:
                cur["likes"] = jumlah
                self.update_info("results",
                                 self.query_one("#results", DataTable).cursor_row)
            return
        if event.worker.name != "ytsearch":
            return
        self._mencari = False
        self.results = event.worker.result or []
        self.refresh_results_table()
        if self.results:
            lagi = f"  ·  m {_('load more')}" if self._limit < 100 else ""
            self._status_hasil(f"{len(self.results)} {_('results for')} “{self._query}”"
                               f"  ·  o {_('sort by views')}{lagi}")
        else:
            self._status_hasil(f"{_('no results for')} “{self._query}”")

    # -- panel info --------------------------------------------------------

    # Peta tab -> tabel isinya, dipakai agar panel info hanya mengikuti tab
    # yang sedang dibuka.
    TAB_TABLE = {"tab-lib": "library", "tab-yt": "results",
                 "tab-queue": "queue", "tab-dl": "downloads",
                 "tab-pl": "album", "tab-radio": "radio",
                 "tab-liked": "liked"}

    # Aksi yang hanya masuk akal di tab tertentu. Selain yang terdaftar di
    # sini, aksi dianggap global (kendali pemutaran, keluar, dan sejenisnya).
    TAB_ACTIONS = {
        "tab-lib":   {"delete_track", "enqueue", "rescan", "shuffle",
                      "add_to_playlist"},
        "tab-yt":    {"download", "toggle_format", "radio", "enqueue",
                      "add_to_playlist", "more_results", "sort_results"},
        "tab-queue": {"dequeue", "queue_up", "queue_down", "play_queue",
                      "add_to_playlist"},
        "tab-pl":    {"new_playlist", "delete_playlist", "remove_from_album",
                      "add_to_playlist"},
        "tab-dl":    set(),
        "tab-radio": {"radio_panel", "enqueue", "add_to_playlist"},
        "tab-liked": {"unlike", "enqueue", "add_to_playlist", "rekomendasi",
                      "radio"},
    }
    CONTEXTUAL = set().union(*TAB_ACTIONS.values())

    def check_action(self, action: str, parameters) -> bool | None:
        """Sembunyikan aksi yang tidak relevan dengan tab yang sedang dibuka.

        Footer Textual membaca hasil fungsi ini, jadi daftar tombol di bawah
        ikut berubah per tab alih-alih menampilkan semuanya sekaligus.
        """
        if action not in self.CONTEXTUAL:
            return True
        try:
            active = self.query_one("#tabs", TabbedContent).active
        except Exception:
            return True
        return action in self.TAB_ACTIONS.get(active, set())

    def _active_table(self) -> str | None:
        try:
            return self.TAB_TABLE.get(self.query_one("#tabs", TabbedContent).active)
        except Exception:
            return None

    def on_data_table_row_highlighted(self, event: DataTable.RowHighlighted) -> None:
        # Tabel yang tidak terlihat tetap memancarkan event saat isinya
        # berubah; tanpa saringan ini panel info bisa menampilkan lagu dari
        # tab lain — misalnya rincian library padahal sedang di tab Unduhan.
        if event.data_table.id != self._active_table():
            return
        self.update_info(event.data_table.id, event.cursor_row)

    def on_tree_node_highlighted(self, event) -> None:
        self.rebuild_song_actions("album")
        self.update_album_info(event.node)

    def update_album_info(self, node) -> None:
        info = self.query_one("#info-text", Static)
        data = getattr(node, "data", None) or {}
        name = data.get("playlist")
        if not name:
            info.update(f"[dim]{_('pick an album or a song inside it')}[/dim]")
            self.show_cover(None)
            return
        if "item" in data:
            it = data["item"]
            target = it.get("target", "")
            self.show_cover(extract_cover(Path(target)) if not target.startswith("http") else None)
            info.update("\n".join([
                f"[b]{it.get('title', '?')}[/b]", "",
                f"album    {name}",
                f"{_('source'):<9}{it.get('source', '?')}",
                "", f"[dim]{target}[/dim]",
            ]))
        else:
            items = self.playlists.get(name, [])
            self.show_cover(None)
            info.update("\n".join([
                f"[b]{name}[/b]", "",
                f"lagu     {len(items)}",
                "", "[dim]enter putar semua[/dim]",
            ]))

    def on_tabbed_content_tab_activated(self, event) -> None:
        table_id = self._active_table()
        if table_id == "album":
            self.rebuild_song_actions("album")
            self.update_album_info(self.query_one("#pltree", Tree).cursor_node)
            return
        if not table_id:
            return
        try:
            table = self.query_one(f"#{table_id}", DataTable)
        except Exception:
            return
        self.update_info(table_id, table.cursor_row)

    def _tinggi_sampul(self) -> int:
        """Tinggi sampul dalam baris, mengikuti kerapatan dan ruang tersisa."""
        dasar = (9, 14, 18)[self.zoom]
        try:
            sempit = self.query_one("#info").has_class("sempit")
        except Exception:
            return dasar
        # Panel sempit MEMPERKECIL, tidak pernah memperbesar. Mematoknya ke
        # angka tetap membuat mode padat justru mendapat sampul lebih tinggi
        # daripada yang dimintanya.
        return min(dasar, 8) if sempit else dasar

    def show_cover(self, image_path: Path | None) -> None:
        """Tampilkan sampul di panel kanan.

        Widget gambar dibuat ulang tiap kali, bukan diganti sumbernya: cara itu
        paling andal di terminal, karena renderer sixel menggambar di luar
        kanvas Textual dan sisa gambar lama bisa tertinggal.
        """
        holder = self.query_one("#cover", Static)
        holder.remove_children()
        if not image_path or not self.image_ok:
            holder.display = False
            return
        try:
            # SixelImage dipaksa, bukan AutoImage. Deteksi otomatis di
            # textual-image jatuh ke renderer blok Unicode di terminal ini —
            # hasilnya kotak-kotak kasar, bukan foto. foot mendukung sixel
            # (grafik sungguhan), jadi renderer itu dipilih langsung dan
            # AutoImage hanya dipakai sebagai cadangan.
            try:
                from textual_image.widget import SixelImage as ImageWidget
            except ImportError:
                from textual_image.widget import Image as ImageWidget

            holder.display = True
            gambar = ImageWidget(str(image_path))
            # Lebar dihitung dari rasio gambar aslinya, bukan dipaksa memenuhi
            # panel. Thumbnail YouTube itu 16:9; direntangkan ke kotak, wajah
            # orang jadi gepeng. Sel terminal kira-kira dua kali lebih tinggi
            # daripada lebarnya, jadi rasionya dikalikan dua.
            tinggi = self._tinggi_sampul()
            rasio = aspek_gambar(image_path)
            if rasio:
                lebar = max(4, min(int(round(tinggi * rasio * 2)),
                                   max(4, holder.size.width or 32)))
                gambar.styles.width = lebar
            gambar.styles.height = tinggi
            holder.mount(gambar)
        except Exception:
            # Terminal tanpa dukungan gambar tidak boleh membuat aplikasi mati;
            # panel cukup kembali ke teks saja.
            holder.display = False
            self.image_ok = False

    # Aksi lagu per konteks: (label, nama aksi). Ditaruh di panel kanan, bukan
    # di footer, supaya jelas mana yang bekerja pada LAGU dan mana yang pada
    # PEMUTARAN.
    SONG_ACTIONS = {
        "library":   [("▶  " + _("play"), "play_selected"), ("＋ " + _("queue"), "enqueue"),
                      ("♪  " + _("album"), "add_to_playlist"), ("✕  " + _("delete file"), "delete_track")],
        "results":   [("▶  " + _("play"), "play_selected"), ("📻 " + _("radio"), "radio"),
                      ("＋ " + _("queue"), "enqueue"), ("♪  " + _("album"), "add_to_playlist"),
                      ("⬇  unduh", "download")],
        "queue":     [("▶  " + _("play queue"), "play_queue"), ("♪  " + _("album"), "add_to_playlist"),
                      ("✕  " + _("remove"), "dequeue")],
        # Tab Album memakai Tree, bukan DataTable. Tanpa entri sendiri di sini
        # panel kanan membeku menampilkan aksi tab sebelumnya, dan aksi
        # "keluarkan dari album" tidak pernah muncul sama sekali.
        "album":     [("▶  " + _("play"), "play_selected"),
                      ("✕  " + _("remove from album"), "remove_from_album"),
                      ("🗑  " + _("delete album"), "delete_playlist")],
        "downloads": [],
        "liked": [("▶  " + _("play"), "play_selected"),
                  ("✨ " + _("recommend from this"), "rekomendasi"),
                  ("📻 " + _("radio from this"), "radio"),
                  ("＋ " + _("queue"), "enqueue"),
                  ("♡  " + _("unlike"), "unlike")],
        "radio": [("▶  " + _("jump to this song"), "play_selected"),
                  ("＋ " + _("queue"), "enqueue"),
                  ("♪  " + _("album"), "add_to_playlist")],
    }

    def rebuild_song_actions(self, table_id: str | None) -> None:
        box = self.query_one("#song-actions", Vertical)
        box.remove_children()
        for label, action in self.SONG_ACTIONS.get(table_id or "", []):
            box.mount(TransportButton(label, action, classes="song-act"))
        self._fit_info_panel()

    def _fit_info_panel(self) -> None:
        """Kecilkan sampul kalau panel kanan tidak cukup tinggi.

        Ambangnya dihitung dari isi panel — sampul penuh, beberapa baris teks,
        dan sebanyak apa pun tombol aksi yang sedang aktif — bukan dari angka
        tetap, supaya tetap benar di terminal berukuran apa pun dan saat
        visualizer dinyalakan atau dimatikan.
        """
        try:
            info = self.query_one("#info")
            n_aksi = len(self.query_one("#song-actions", Vertical).children)
        except Exception:
            return
        butuh = 14 + 5 + n_aksi          # sampul + teks ringkas + tombol
        info.set_class(info.content_size.height < butuh, "sempit")

    def on_resize(self, event) -> None:
        self._fit_info_panel()
        # Bar bawah digambar dari nilai yang jarang berubah (judul, posisi,
        # volume), jadi setelah ukuran jendela berubah widget-widgetnya tidak
        # punya alasan menggambar ulang — isinya baru muncul setelah tersentuh
        # kursor. Dipaksa segar di sini.
        self.refresh_now_playing()
        for pilih in ("#np-bar", "#vol-bar", "#np-title", "#np-elapsed",
                      "#np-total", "#cava"):
            try:
                self.query_one(pilih).refresh(layout=True)
            except Exception:
                pass

    async def action_play_selected(self) -> None:
        """Putar lagu yang sedang disorot, dari tab mana pun."""
        song = self._selected_song()
        if song:
            await self.player.play(song["target"])

    # Petunjuk saat sebuah tab belum punya isi. Panel kosong melompong tidak
    # memberi tahu apa pun tentang apa yang bisa dilakukan di sana.
    PETUNJUK = {
        "results": lambda: (f"[b]{_('Search YouTube')}[/b]\n\n"
                            f"{_('Type above and press Enter.')}\n\n"
                            f"[dim]{_('after results appear:')}\n"
                            f"  enter  {_('play')}\n"
                            f"  d      {_('download')}\n"
                            f"  R      {_('radio')}\n"
                            f"  +      {_('queue')}\n"
                            f"  m      {_('load more')}\n"
                            f"  o      {_('sort by views')}[/dim]"),
        "queue": lambda: (f"[b]{_('Queue is empty')}[/b]\n\n"
                          f"[dim]{_('add songs with + from Library or Search,')}\n"
                          f"{_('then press enter here to play them all.')}[/dim]"),
        "library": lambda: (f"[b]{_('Library is empty')}[/b]\n\n"
                            f"[dim]{_('download from Search with d, or put')}\n"
                            f"{_('files in ~/Music and press r to rescan.')}[/dim]"),
        "liked": lambda: (f"[b]{_('No liked songs yet')}[/b]\n\n"
                          f"[dim]{_('press l on any song to like it.')}\n"
                          f"{_('musicbox builds recommendations from this list.')}[/dim]"),
        "radio": lambda: (f"[b]{_('Radio is off')}[/b]\n\n"
                          f"[dim]{_('pick a song in Search and press R.')}\n"
                          f"{_('radio follows YouTube recommendations')}\n"
                          f"{_('based on that song.')}[/dim]"),
        "downloads": lambda: (f"[b]{_('No downloads yet')}[/b]\n\n"
                              f"[dim]{_('pick a song in Search and press d.')}\n"
                              f"{_('f switches between mp3 and opus.')}[/dim]"),
    }

    def _show_cover_for(self, target: str | None) -> None:
        """Tampilkan sampul sebuah lagu, baik berkas lokal maupun dari YouTube.

        Selalu dipanggil, termasuk saat tidak ada sampulnya — kalau tidak,
        gambar dari baris yang disorot sebelumnya tertinggal di panel dan
        seolah-olah menjadi sampul lagu yang sekarang.
        """
        if not target:
            self.show_cover(None)
            return
        target = str(target)
        if target.startswith("http"):
            vid = ""
            for bagian in target.split("?", 1)[-1].split("&"):
                if bagian.startswith("v="):
                    vid = bagian[2:]
                    break
            if vid:
                self.run_worker(lambda: (vid, fetch_thumbnail(vid)), thread=True,
                                name="thumb", group="thumb", exit_on_error=False)
            else:
                self.show_cover(None)
        else:
            self.show_cover(extract_cover(Path(target)))

    def update_info(self, table_id: str, idx: int) -> None:
        """Isi panel kanan sesuai baris yang sedang disorot."""
        info = self.query_one("#info-text", Static)
        self.rebuild_song_actions(table_id)
        lines: list[str] = []
        if table_id == "library" and 0 <= idx < len(self.library.tracks):
            t = self.library.tracks[idx]
            p = Path(t["path"])
            size = p.stat().st_size / 1e6 if p.exists() else 0
            self.show_cover(extract_cover(p))
            lines = [
                f"[b]{t['title']}[/b]", "",
                f"{_('artist'):<9}{t['artist'] or '—'}",
                f"{_('duration'):<9}{fmt_time(t['duration'])}",
                f"{_('format'):<9}{p.suffix.lstrip('.') or '—'}",
                f"{_('size'):<9}{size:.1f} MB",
                "", f"[dim]{p.name}[/dim]",
            ]
        elif table_id == "results" and 0 <= idx < len(self.results):
            r = self.results[idx]
            # Thumbnail diunduh di thread supaya UI tidak beku saat menyorot
            # cepat-cepat melewati daftar hasil.
            self._show_cover_for(yt_url(r["id"]))
            # Likes menuntut ekstraksi penuh, jadi baru diambil untuk baris yang
            # benar-benar dilihat — dan hanya sekali per video.
            if "likes" not in r:
                r["likes"] = "…"
                vid = r["id"]
                self.run_worker(lambda: yt_likes(vid), thread=True,
                                name="likes", group="likes", exit_on_error=False)
            lines = [
                f"[b]{r['title']}[/b]", "",
                f"{_('channel'):<9}{r['uploader']}",
                f"{_('duration'):<9}{r['duration']}",
                f"{_('views'):<9}{fmt_count(r.get('views'))}",
                f"{_('likes'):<9}{r['likes'] if r['likes'] == '…' else fmt_count(r['likes'])}",
                *( [f"[b]⭳ {_('already downloaded')}[/b]"]
                   if self.sudah_diunduh(r) else [] ),
                "", f"[dim]{yt_url(r['id'])}[/dim]",
                "", f"[dim]enter {_('play')} · d {_('download')} · R {_('radio')}[/dim]",
            ]
        elif table_id == "queue" and 0 <= idx < len(self.queue):
            q = self.queue[idx]
            target = q.get("target", "")
            self._show_cover_for(target)
            lokal = not str(target).startswith("http")
            lagu = next((x for x in self.library.tracks
                         if x["path"] == str(target)), None) if lokal else None
            lines = [f"[b]{q.get('title', '?')}[/b]", "",
                     f"{_('position'):<9}{idx + 1} {_('of')} {len(self.queue)}",
                     f"{_('source'):<9}{q.get('source', '—')}"]
            if lagu:
                lines += [f"{_('artist'):<9}{lagu['artist'] or '—'}",
                          f"{_('duration'):<9}{fmt_time(lagu['duration'])}"]
            lines += ["", f"[dim]{Path(target).name if lokal else target}[/dim]"]
        elif table_id == "liked" and 0 <= idx < len(self.liked):
            lagu = self.liked[idx]
            self._show_cover_for(lagu.get("target"))
            lines = [f"[b]{lagu.get('title', '?')}[/b]", "",
                     f"{_('source'):<9}{lagu.get('source', '—')}",
                     f"{_('position'):<9}{idx + 1} {_('of')} {len(self.liked)}",
                     "", f"[dim]{lagu.get('target', '')}[/dim]",
                     "", f"[dim]V {_('recommend')} · R {_('radio')} · u {_('unlike')}[/dim]"]
        elif table_id == "radio" and 0 <= idx < len(self.radio_list):
            e = self.radio_list[idx]
            judul = e.get("title") or Path(str(e.get("filename", "?"))).name
            self._show_cover_for(e.get("filename"))
            lines = [f"[b]{judul}[/b]", "",
                     f"{_('position'):<9}{idx + 1} {_('of')} {len(self.radio_list)}",
                     "sumber   radio YouTube",
                     "", f"[dim]{e.get('filename', '')}[/dim]",
                     "", f"[dim]{_('enter jumps to this song')}[/dim]"]
        elif table_id == "downloads" and 0 <= idx < len(self.downloads):
            d = self.downloads[idx]
            self._show_cover_for(d.get("url"))
            lines = [
                f"[b]{d.get('title', '?')}[/b]", "",
                f"{_('format'):<9}{d.get('format', '?')}",
                f"{_('status'):<9}{d.get('status', '?')}",
                f"{_('time'):<9}{d.get('time', '?')}",
                "", f"[dim]{d.get('url', '')}[/dim]",
            ]
        if not lines:
            # Tidak ada baris yang disorot: tampilkan petunjuk tab ini, bukan
            # panel kosong yang tidak menjelaskan apa pun.
            self.show_cover(None)
            petunjuk = self.PETUNJUK.get(table_id)
            lines = [petunjuk() if petunjuk else ""]
        info.update("\n".join(lines))

    # -- antrean -----------------------------------------------------------

    def load_queue(self) -> None:
        try:
            self.queue = json.loads(QUEUE_FILE.read_text())
        except (OSError, json.JSONDecodeError):
            self.queue = []
        self.refresh_queue_table()

    def save_queue(self) -> None:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        try:
            QUEUE_FILE.write_text(json.dumps(self.queue, indent=1))
        except OSError:
            pass

    def refresh_queue_table(self) -> None:
        table = self.query_one("#queue", DataTable)
        keep = table.cursor_row
        table.clear()
        for i, q in enumerate(self.queue, 1):
            table.add_row(str(i), q.get("title", "?"), q.get("source", "lokal"))
        if 0 <= keep < len(self.queue):
            table.move_cursor(row=keep)

    def enqueue(self, title: str, target: str, source: str = "lokal") -> None:
        self.queue.append({"title": title, "target": target, "source": source})
        self.save_queue()
        self.refresh_queue_table()
        self.notify(f"antrean +1 ({len(self.queue)})", timeout=2)

    def action_enqueue(self) -> None:
        """Tambah baris yang sedang disorot ke antrean."""
        active = self._active_table()
        if active == "library":
            idx = self.query_one("#library", DataTable).cursor_row
            if 0 <= idx < len(self.library.tracks):
                t = self.library.tracks[idx]
                item = {"title": t["title"], "target": t["path"], "source": "lokal"}
                self._pending_add = item
                self.enqueue(**item)
        elif active == "results":
            r = self._selected_result()
            if r:
                item = {"title": r["title"], "target": yt_url(r["id"]),
                        "source": "youtube"}
                self._pending_add = item
                self.enqueue(**item)
        else:
            self.notify("pilih dari Library atau Cari", timeout=3)

    def action_dequeue(self) -> None:
        if self._active_table() != "queue":
            return
        idx = self.query_one("#queue", DataTable).cursor_row
        if 0 <= idx < len(self.queue):
            self.queue.pop(idx)
            self.save_queue()
            self.refresh_queue_table()

    def _move_in_queue(self, delta: int) -> None:
        if self._active_table() != "queue":
            return
        table = self.query_one("#queue", DataTable)
        i = table.cursor_row
        j = i + delta
        if 0 <= i < len(self.queue) and 0 <= j < len(self.queue):
            self.queue[i], self.queue[j] = self.queue[j], self.queue[i]
            self.save_queue()
            self.refresh_queue_table()
            table.move_cursor(row=j)

    def action_queue_up(self) -> None:
        self._move_in_queue(-1)

    def action_queue_down(self) -> None:
        self._move_in_queue(1)

    async def action_play_queue(self, loop: bool = False) -> None:
        """Putar antrean dari awal, sisanya diantrekan ke playlist mpv."""
        if not self.queue:
            self.notify("antrean kosong", timeout=2)
            return
        await self.player.set_loop(loop)
        await self.player.play(self.queue[0]["target"])
        for q in self.queue[1:]:
            await self.player.append(q["target"])
        self.notify(f"memutar {len(self.queue)} lagu" + (" · diulang" if loop else ""),
                    timeout=2)

    # -- playlist tersimpan ------------------------------------------------

    def load_playlists(self) -> None:
        """Muat semua playlist dan gambarkan sebagai tree.

        Bentuk tree dipilih karena satu playlist berisi banyak lagu — daftar
        datar akan mencampur nama playlist dengan isinya. Node induk bisa
        dilipat, persis seperti pohon berkas di editor kode.
        """
        PLAYLIST_DIR.mkdir(parents=True, exist_ok=True)
        self.playlists = {}
        for f in sorted(PLAYLIST_DIR.glob("*.json")):
            try:
                self.playlists[f.stem] = json.loads(f.read_text())
            except (OSError, json.JSONDecodeError):
                continue

        tree = self.query_one("#pltree", Tree)
        tree.clear()
        tree.root.label = f"album ({len(self.playlists)})"
        tree.root.expand()
        for name, items in self.playlists.items():
            node = tree.root.add(f"{name}  ({len(items)})", data={"playlist": name})
            for it in items:
                node.add_leaf(it.get("title", "?"),
                              data={"playlist": name, "item": it})
            # Dibentangkan sejak awal: album yang terlipat menyembunyikan isinya
            # sehingga lagunya tidak bisa disorot maupun dikeluarkan.
            node.expand()

    def action_new_playlist(self) -> None:
        """Buat playlist baru yang kosong.

        Alurnya sengaja begini, bukan "simpan antrean sebagai playlist": kamu
        membuat wadahnya dulu, lalu mengisinya lagu per lagu dari Library atau
        Cari. Itu lebih dekat dengan cara orang menyusun playlist.
        """
        self.push_screen(PlaylistNameScreen(), self._do_new_playlist)

    def _do_new_playlist(self, name: str | None) -> str | None:
        if not name:
            return None
        # Nama file dibersihkan: hanya huruf, angka, spasi, strip.
        safe = "".join(c for c in name if c.isalnum() or c in " -_").strip()
        if not safe:
            self.notify("nama tidak valid", severity="error", timeout=3)
            return None
        target = PLAYLIST_DIR / f"{safe}.json"
        if target.exists():
            self.notify("nama sudah dipakai", severity="warning", timeout=3)
            return None
        PLAYLIST_DIR.mkdir(parents=True, exist_ok=True)
        try:
            target.write_text("[]")
        except OSError as exc:
            self.notify(f"gagal buat: {exc}", severity="error", timeout=4)
            return None
        self.load_playlists()
        self.notify(f"album '{safe}' dibuat", timeout=3)
        return safe

    def _current_playlist(self) -> str | None:
        node = self.query_one("#pltree", Tree).cursor_node
        return node.data.get("playlist") if node and node.data else None

    def _selected_song(self) -> dict | None:
        """Lagu yang sedang disorot, dari tab mana pun yang aktif."""
        active = self._active_table()
        if active == "library":
            idx = self.query_one("#library", DataTable).cursor_row
            if 0 <= idx < len(self.library.tracks):
                t = self.library.tracks[idx]
                return {"title": t["title"], "target": t["path"], "source": "lokal"}
        elif active == "results":
            r = self._selected_result()
            if r:
                return {"title": r["title"], "target": yt_url(r["id"]),
                        "source": "youtube"}
        elif active == "queue":
            idx = self.query_one("#queue", DataTable).cursor_row
            if 0 <= idx < len(self.queue):
                return dict(self.queue[idx])
        elif active == "liked":
            idx = self.query_one("#liked", DataTable).cursor_row
            if 0 <= idx < len(self.liked):
                return dict(self.liked[idx])
        elif active == "radio":
            idx = self.query_one("#radio", DataTable).cursor_row
            if 0 <= idx < len(self.radio_list):
                e = self.radio_list[idx]
                return {"title": e.get("title")
                                 or Path(str(e.get("filename", "?"))).name,
                        "target": str(e.get("filename", "")),
                        "source": "radio"}
        elif active == "album":
            # Sumbernya Tree, jadi lagu diambil dari node yang disorot.
            node = self.query_one("#pltree", Tree).cursor_node
            data = getattr(node, "data", None) or {}
            if "item" in data:
                return dict(data["item"])
        return None

    def action_add_to_playlist(self) -> None:
        """Tambahkan lagu yang disorot ke album — pilih tujuannya lewat dialog."""
        song = self._selected_song()
        if not song:
            self.notify("sorot lagu di Library, Cari, atau Antrean", timeout=4)
            return
        self._pending_add = song
        self.push_screen(AlbumPicker(sorted(self.playlists)), self._add_to_album)

    def _add_to_album(self, name: str | None) -> None:
        if name is None:
            return
        if name == "":
            # Pilihan "buat album baru": rantai ke dialog nama.
            self.push_screen(PlaylistNameScreen(), self._new_album_with_song)
            return
        self._append_to_album(name, self._pending_add)

    def _new_album_with_song(self, name: str | None) -> None:
        created = self._do_new_playlist(name)
        if created:
            self._append_to_album(created, self._pending_add)

    def _append_to_album(self, name: str, item: dict | None) -> None:
        if not item:
            return
        items = list(self.playlists.get(name, []))
        # Tolak duplikat: satu lagu cukup sekali dalam satu album. Tanpa ini
        # menekan tambah dua kali menghasilkan entri kembar yang membingungkan
        # saat diputar maupun dikeluarkan.
        if any(i.get("target") == item.get("target") for i in items):
            self.notify(f"sudah ada di '{name}'", severity="warning", timeout=3)
            return
        items.append(item)
        try:
            (PLAYLIST_DIR / f"{name}.json").write_text(json.dumps(items, indent=1))
        except OSError as exc:
            self.notify(f"gagal simpan: {exc}", severity="error", timeout=4)
            return
        self.load_playlists()
        self.notify(f"+1 ke '{name}'", timeout=2)

    def action_remove_from_album(self) -> None:
        """Hapus satu lagu dari album (daun yang disorot di tree)."""
        node = self.query_one("#pltree", Tree).cursor_node
        if not node or not node.data or "item" not in node.data:
            self.notify("sorot lagunya di dalam album", timeout=3)
            return
        name = node.data["playlist"]
        target = node.data["item"].get("target")
        items = [i for i in self.playlists.get(name, []) if i.get("target") != target]
        try:
            (PLAYLIST_DIR / f"{name}.json").write_text(json.dumps(items, indent=1))
        except OSError as exc:
            self.notify(f"gagal simpan: {exc}", severity="error", timeout=4)
            return
        self.load_playlists()
        self.notify(f"dihapus dari '{name}'", timeout=2)

    def action_delete_playlist(self) -> None:
        node = self.query_one("#pltree", Tree).cursor_node
        if not node or not node.data or "item" in node.data:
            self.notify("pilih nama playlist-nya", timeout=3)
            return
        name = node.data["playlist"]
        if self._pending_delete == f"pl:{name}":
            try:
                (PLAYLIST_DIR / f"{name}.json").unlink()
            except OSError as exc:
                self.notify(f"gagal hapus: {exc}", severity="error", timeout=4)
                return
            self._pending_delete = None
            self.load_playlists()
            self.notify("playlist dihapus", timeout=2)
        else:
            self._pending_delete = f"pl:{name}"
            self.notify("tekan x lagi untuk hapus", timeout=4)
            self.set_timer(4.0, lambda: setattr(self, "_pending_delete", None))

    async def on_tree_node_selected(self, event) -> None:
        data = event.node.data
        if not data:
            return
        if "item" in data:
            # Daun: putar SELURUH album mulai dari lagu ini, bukan lagu itu
            # sendirian. Memuat satu lagu saja membuat mpv tidak punya playlist,
            # sehingga tombol "berikut" tidak punya tujuan dan pemutaran
            # berhenti begitu lagu itu habis.
            name = data["playlist"]
            items = list(self.playlists.get(name, []))
            target = data["item"].get("target")
            start = next((i for i, it in enumerate(items)
                          if it.get("target") == target), 0)
            self.queue = items[start:] + items[:start]
            self.save_queue()
            self.refresh_queue_table()
            await self.action_play_queue(loop=True)
        else:
            # Induk: seluruh playlist dimuat ke antrean lalu diputar.
            self.queue = list(self.playlists.get(data["playlist"], []))
            self.save_queue()
            self.refresh_queue_table()
            # Album diulang terus. Album biasanya pendek; berhenti senyap
            # setelah lagu terakhir terasa seperti pemutarnya mati.
            await self.action_play_queue(loop=True)

    # -- riwayat unduhan ---------------------------------------------------

    def load_downloads(self) -> None:
        try:
            self.downloads = json.loads(DOWNLOADS_LOG.read_text())
        except (OSError, json.JSONDecodeError):
            self.downloads = []
        self.refresh_downloads_table()

    def refresh_downloads_table(self) -> None:
        table = self.query_one("#downloads", DataTable)
        table.clear()
        for d in self.downloads:
            table.add_row(d.get("title", "?"), d.get("format", "?"),
                          progress_cell(d), d.get("time", ""))

    def save_downloads(self) -> None:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        try:
            DOWNLOADS_LOG.write_text(json.dumps(self.downloads, indent=1))
        except OSError:
            pass

    def log_download(self, entry: dict) -> None:
        self.downloads.insert(0, entry)
        self.downloads = self.downloads[:100]
        self.save_downloads()
        self.refresh_downloads_table()

    def _after_download(self) -> None:
        """Pindai ulang library supaya lagu yang baru turun langsung terlihat."""
        try:
            sebelum = len(self.library.tracks)
            self.load_library(force=True)
            baru = len(self.library.tracks) - sebelum
            if baru > 0:
                self.notify(f"unduhan selesai · {baru} lagu masuk library",
                            timeout=4)
            else:
                self.notify("unduhan selesai", timeout=3)
        except Exception:
            pass

    def _tick_downloads(self) -> None:
        """Perbarui sel progres unduhan yang sedang berjalan.

        Hanya sel yang berubah yang disentuh. Membangun ulang seluruh tabel tiap
        setengah detik akan melompatkan kursor pengguna terus-menerus, dan baris
        yang baru selesai perlu ikut disegarkan sekali lagi supaya statusnya
        berubah dari bar menjadi "selesai".
        """
        aktif = {i for i, d in enumerate(self.downloads)
                 if d.get("status") == "berjalan"}
        perlu = aktif | self._dl_terakhir
        if not perlu:
            return
        try:
            table = self.query_one("#downloads", DataTable)
        except Exception:
            return
        for i in sorted(perlu):
            if i < len(self.downloads):
                try:
                    table.update_cell_at((i, 2), progress_cell(self.downloads[i]))
                except Exception:
                    pass
        self._dl_terakhir = aktif

    def _selected_result(self) -> dict | None:
        table = self.query_one("#results", DataTable)
        idx = table.cursor_row
        return self.results[idx] if 0 <= idx < len(self.results) else None

    def sudah_diunduh(self, hasil: dict) -> str | None:
        """Nama berkas kalau lagu ini sudah ada di ~/Music, None kalau belum.

        Dicocokkan lewat URL yang tercatat di log unduhan lebih dulu — itu
        tanda paling pasti. Kalau logya sudah terpangkas, judulnya dibandingkan
        dengan nama berkas di library, karena yt-dlp memakai judul sebagai nama
        berkas.
        """
        url = yt_url(hasil.get("id", ""))
        for d in self.downloads:
            if d.get("url") == url and d.get("status") == "selesai":
                return d.get("title") or url
        judul = unicodedata.normalize("NFKD", hasil.get("title", "")).strip().lower()
        if not judul:
            return None
        for t in self.library.tracks:
            nama = unicodedata.normalize("NFKD", Path(t["path"]).stem).strip().lower()
            if nama == judul:
                return Path(t["path"]).name
        return None

    async def action_download(self) -> None:
        """Unduh hasil terpilih lewat skrip `music`.

        Perintah yt-dlp tidak ditulis ulang di sini: flag di `music -d` sudah
        teruji (mp3/opus, embed sampul & metadata, jebakan ekstensi). Dua
        salinan berarti dua tempat yang bisa menyimpang.
        """
        r = self._selected_result()
        if not r:
            self.notify(_("pick a search result first"), timeout=3)
            return
        # Mengunduh ulang lagu yang sudah ada cuma menghabiskan kuota dan
        # melahirkan berkas kembar bernama "... (1)".
        ada = self.sudah_diunduh(r)
        if ada and self._pending_dl != r.get("id"):
            self._pending_dl = r.get("id")
            self.notify(f"{_('Already in your library')}: {ada[:40]}\n"
                        f"[dim]{_('press d again to download anyway')}[/dim]",
                        severity="warning", timeout=6)
            self.set_timer(6.0, lambda: setattr(self, "_pending_dl", None))
            return
        self._pending_dl = None
        cmd = [str(HOME / ".local/bin/music"), "-d"]
        if self.dl_format == "opus":
            cmd.insert(1, "-o")
        url = yt_url(r["id"])
        cmd.append(url)
        fmt, title = self.dl_format, r["title"]
        self.notify(f"unduh: {fmt}", timeout=3)
        entry = {"title": title, "format": fmt, "status": "berjalan",
                 "url": url, "time": time.strftime("%H:%M"), "percent": 0.0}
        self.log_download(entry)

        def run_and_log() -> int:
            # Dibaca baris demi baris supaya progresnya bisa ditampilkan, bukan
            # ditelan sampai selesai. Entri dipegang lewat objeknya, bukan lewat
            # indeks: unduhan lain yang menyusul akan menggeser posisinya.
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                    stderr=subprocess.STDOUT, text=True,
                                    bufsize=1, errors="replace")
            for line in proc.stdout or ():
                parse_progress(line, entry)
            rc = proc.wait()
            entry["status"] = "selesai" if rc == 0 else "gagal"
            self.save_downloads()
            # Lagu yang baru turun harus langsung ada di Library. Tanpa ini
            # pengguna menunggu sesuatu yang tidak akan pernah muncul sendiri.
            if rc == 0:
                self.call_from_thread(self._after_download)
            return rc

        self.run_worker(run_and_log, thread=True, name="download",
                        group="yt", exit_on_error=False)

    def action_toggle_format(self) -> None:
        self.dl_format = "opus" if self.dl_format == "mp3" else "mp3"
        self.notify(f"format: {self.dl_format}", timeout=2)

    async def action_radio(self) -> None:
        r = self._selected_result()
        if not r:
            self.notify("pilih hasil pencarian dulu", timeout=3)
            return
        await self.player.play_radio(yt_radio_url(r["id"]))
        self.notify("radio dimulai", timeout=2)

    # -- pemutaran ---------------------------------------------------------

    async def on_data_table_row_selected(self, event: DataTable.RowSelected) -> None:
        if event.data_table.id == "radio":
            idx = event.cursor_row
            if 0 <= idx < len(self.radio_list):
                await self.player.play_index(idx)
                self.notify(f"lompat ke lagu {idx + 1}", timeout=2)
                self.call_after_refresh(
                    lambda: self.run_worker(self.refresh_radio(), exclusive=False))
            return
        if event.data_table.id == "results":
            r = self._selected_result()
            if r:
                # Saat autoplay hidup, yang dimuat adalah playlist Mix (list=RD)
                # bukan video tunggal — sehingga tombol "berikut" menyambung ke
                # rekomendasi YouTube, persis seperti YouTube Music.
                await self.player.play(
                    yt_radio_url(r["id"]) if self.autoplay else yt_url(r["id"]))
            return
        idx = event.cursor_row
        if not (0 <= idx < len(self.library.tracks)):
            return
        tracks = self.library.tracks
        await self.player.play(tracks[idx]["path"])
        if self.autoplay:
            # Sisa library diantrekan ke playlist mpv supaya lagu berlanjut
            # sendiri tanpa perlu ditekan apa-apa.
            for t in tracks[idx + 1:] + tracks[:idx]:
                await self.player.append(t["path"])

    async def on_transport_button_pressed(self, message: TransportButton.Pressed) -> None:
        action = message.action
        if action == "pause":
            await self.player.toggle_pause()
        elif action == "next":
            await self.player.next_track()
        elif action == "prev":
            await self.player.prev_track()
        elif action == "stop":
            await self.player.stop()
        elif action == "shuffle":
            await self.action_shuffle()
        elif action == "autoplay":
            self.action_toggle_autoplay()
        elif action == "cava":
            self.action_toggle_cava()
        else:
            # Aksi dari panel kanan (tombol lagu). Dijalankan lewat nama supaya
            # daftar SONG_ACTIONS tetap jadi satu-satunya sumber kebenaran.
            handler = getattr(self, f"action_{action}", None)
            if handler:
                result = handler()
                if asyncio.iscoroutine(result):
                    await result

    async def on_volume_bar_changed(self, message: VolumeBar.Changed) -> None:
        await self.player.set_volume_abs(message.fraction * 130)
        label = self.query_one("#vol-label", Static)
        if message.show:
            label.update(f"{int(message.fraction * 130)}%")
            # Kembalikan ke ikon setelah sesaat supaya bar tetap bersih.
            self.set_timer(1.5, lambda: label.update("🕪"))

    async def action_shuffle(self) -> None:
        tracks = list(self.library.tracks)
        if not tracks:
            return
        random.shuffle(tracks)
        await self.player.play(tracks[0]["path"])
        for t in tracks[1:]:
            await self.player.append(t["path"])
        self.notify("diacak", timeout=2)

    def action_toggle_autoplay(self) -> None:
        self.autoplay = not self.autoplay
        btn = self.query_one("#btn-auto", TransportButton)
        btn.update("↻ " + (_("auto") if self.autoplay else _("off")))
        btn.set_class(self.autoplay, "on")
        btn.set_class(not self.autoplay, "off")
        self.notify("autoplay on" if self.autoplay else "autoplay off", timeout=2)

    def action_toggle_cava(self) -> None:
        """Sembunyikan visualizer sekaligus hentikan prosesnya.

        Sekadar menyembunyikan widget tidak cukup — cava tetap jalan dan makan
        ~16 MB. Prosesnya ikut dimatikan supaya benar-benar hemat.
        """
        cava = self.query_one("#cava", CavaBars)
        btn = self.query_one("#btn-cava", TransportButton)
        self.cava_on = not self.cava_on
        cava.display = self.cava_on
        btn.update("◫ " + (_("cava") if self.cava_on else _("off")))
        btn.set_class(self.cava_on, "on")
        btn.set_class(not self.cava_on, "off")
        self.call_after_refresh(self._fit_info_panel)
        if self.cava_on:
            self.run_worker(cava.restart(), exclusive=False)
        else:
            cava.stop()
        self.notify("cava on" if self.cava_on else "cava off", timeout=2)

    async def action_toggle_pause(self) -> None:
        await self.player.toggle_pause()

    async def action_next(self) -> None:
        await self.player.next_track()

    async def action_prev(self) -> None:
        await self.player.prev_track()

    async def action_stop(self) -> None:
        await self.player.stop()

    async def action_seek_fwd(self) -> None:
        await self.player.seek(5)

    async def action_seek_back(self) -> None:
        await self.player.seek(-5)

    async def action_vol_up(self) -> None:
        await self.player.set_volume(5)

    async def action_vol_down(self) -> None:
        await self.player.set_volume(-5)

    def action_rescan(self) -> None:
        self.load_library(force=True)
        self.notify("library dipindai", timeout=2)

    # -- lanjut dari terakhir ---------------------------------------------

    def save_resume(self) -> None:
        """Simpan lagu dan posisi terakhir supaya bisa dilanjutkan.

        Ditulis saat keluar, bukan berkala, supaya tidak menyentuh disk
        terus-menerus selama memutar.
        """
        st = self.player.state
        path = st.get("path")
        if not path:
            return
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        try:
            RESUME_FILE.write_text(json.dumps({
                "path": path,
                "position": st.get("time-pos") or 0.0,
                "title": st.get("title") or "",
            }))
        except OSError:
            pass

    async def restore_resume(self) -> None:
        try:
            data = json.loads(RESUME_FILE.read_text())
        except (OSError, json.JSONDecodeError):
            return
        path, pos = data.get("path"), data.get("position") or 0.0
        if not path:
            return
        # Sengaja dimuat dalam keadaan JEDA: membuka aplikasi tidak seharusnya
        # langsung mengeluarkan suara. Tekan spasi untuk melanjutkan.
        await self.player.load_paused(path, pos)
        self.notify(f"lanjut: {fmt_time(pos)}", timeout=3)

    def action_delete_track(self) -> None:
        table = self.query_one("#library", DataTable)
        idx = table.cursor_row
        if not (0 <= idx < len(self.library.tracks)):
            return
        track = self.library.tracks[idx]
        if self._pending_delete == track["path"]:
            try:
                Path(track["path"]).unlink()
            except OSError as exc:
                self.notify(f"gagal hapus: {exc}", severity="error", timeout=4)
                return
            self._pending_delete = None
            self.load_library(force=True)
            self.notify("dihapus", timeout=2)
        else:
            # Konfirmasi dua langkah: menghapus file tidak bisa dibatalkan.
            self._pending_delete = track["path"]
            self.notify("tekan x lagi untuk hapus", timeout=4)
            self.set_timer(4.0, lambda: setattr(self, "_pending_delete", None))

    def on_unmount(self) -> None:
        self.save_resume()
        if self.mpris is not None:
            self.mpris.stop()
        self.player.shutdown()
        try:
            self.query_one("#cava", CavaBars).stop()
        except Exception:
            pass


LOCK_FILE = RUNTIME / "musicbox.lock"


def already_running() -> int | None:
    """Kembalikan PID instans lain yang masih hidup, kalau ada.

    Perlu karena semua instans memakai socket mpv yang sama; instans kedua
    akan menimpa socket milik yang pertama sehingga yang lama kehilangan
    kendali atas pemutarnya. Selain itu dua pemutar akan berebut audio dan
    mendaftarkan MPRIS ganda.
    """
    try:
        pid = int(LOCK_FILE.read_text().strip())
    except (OSError, ValueError):
        return None
    if pid == os.getpid():
        return None
    try:
        # Signal 0 hanya memeriksa keberadaan proses, tidak mengirim apa pun.
        os.kill(pid, 0)
    except (ProcessLookupError, PermissionError):
        return None
    try:
        cmd = Path(f"/proc/{pid}/cmdline").read_bytes().decode(errors="ignore")
    except OSError:
        return None
    return pid if "musicbox" in cmd else None


def cek_sixel() -> bool:
    """Tanyakan dukungan sixel ke terminal SEBELUM Textual mulai berjalan.

    textual-image bicara langsung ke terminal: ia mengirim query lalu membaca
    balasannya sendiri. Balasan itu berbentuk `ESC [ ? 62 ; 4 c`, dan sisa byte
    yang tidak sempat ia telan akan sampai ke Textual sebagai penekanan tombol
    — termasuk `?`. Kalau `?` kebetulan terikat ke sebuah aksi, aksi itu jalan
    sendiri tepat saat aplikasi dibuka.

    Dilakukan di sini, saat belum ada yang membaca papan ketik, sehingga
    balasannya habis di tempat yang benar.
    """
    try:
        from textual_image.renderable import Image  # noqa: F401
        return True
    except Exception:
        return False


def main() -> int:
    muat_bahasa()
    cek_sixel()
    if shutil.which("mpv") is None:
        print("mpv belum terpasang", flush=True)
        return 1

    other = already_running()
    if other:
        print(f"musicbox sudah berjalan (pid {other}).", flush=True)
        print("Gunakan jendela yang sudah terbuka, atau Super+Alt+M untuk memunculkannya.",
              flush=True)
        return 1

    LOCK_FILE.parent.mkdir(parents=True, exist_ok=True)
    try:
        LOCK_FILE.write_text(str(os.getpid()))
    except OSError:
        pass
    try:
        MusicBox().run()
    finally:
        # Hanya hapus kalau lock ini memang milik kita — mencegah instans lain
        # kehilangan lock-nya saat proses ini berakhir.
        try:
            if LOCK_FILE.read_text().strip() == str(os.getpid()):
                LOCK_FILE.unlink(missing_ok=True)
        except OSError:
            pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
