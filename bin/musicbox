def muat_bahasa() -> str:
    global _BAHASA
    try:
        pilihan = LANG_FILE.read_text().strip()
    except OSError:
        pilihan = ""
    _BAHASA = pilihan if pilihan in ("en", "id") else "en"
    return _BAHASA


def simpan_bahasa(kode: str) -> None:
    global _BAHASA
    _BAHASA = kode if kode in ("en", "id") else "en"
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        LANG_FILE.write_text(_BAHASA)
    except OSError:
        pass


def _(teks: str) -> str:
    """Terjemahkan teks antarmuka. Bahasa Inggris dipakai apa adanya."""
    if _BAHASA == "en":
        return teks
    return TERJEMAHAN.get(_BAHASA, {}).get(teks, teks)


# ------------------------------------------------------------------- lirik


LYRICS_CACHE = STATE_DIR / "lyrics"
LIKED_FILE = STATE_DIR / "liked.json"
# Embel-embel judul YouTube yang menyesatkan pencarian lirik: "(1 Hour)",
# "[slowed + reverb]", "| Best part looped", dan sejenisnya.
_SAMPAH_JUDUL = re.compile(
    r"\((?:[^()]*)\)|\[[^\]]*\]|\b(?:official|video|audio|lyrics?|lyric|hd|hq|"
    r"full|album|version|remix|cover|live|slowed|reverb|sped\s*up|nightcore|"
    r"loop(?:ed)?|extended|best\s*part|\d+\s*hours?|4k|mv)\b",
    re.IGNORECASE)


def bersihkan_judul(judul: str) -> tuple[str, str]:
    """Pisahkan artis dan judul dari nama berkas YouTube yang penuh embel-embel.

    Judul unduhan biasanya berbunyi seperti
    "Golden Brown - The Stranglers | Best part looped (slowed + reverb)".
    Pencarian lirik hanya butuh lagunya; sisanya justru membuat pencocokan
    meleset.
    """
    # Kanal YouTube gemar memakai huruf hias di luar ASCII — "𝑿𝒆𝒍𝒉" terbaca
    # seperti kata biasa oleh mata, tapi tidak cocok dengan apa pun saat dicari.
    # NFKD mengembalikannya ke huruf biasa, sekalian meratakan pemisah lebar
    # penuh seperti "｜" menjadi "|" supaya pemotongan di bawah ikut kena.
    teks = unicodedata.normalize("NFKD", judul)
    teks = teks.split("|")[0]
    teks = _SAMPAH_JUDUL.sub(" ", teks)
    teks = re.sub(r"[_·•]+", " ", teks)
    teks = re.sub(r"\s{2,}", " ", teks).strip(" -–—\t")
    if " - " in teks:
        kiri, kanan = (b.strip() for b in teks.split(" - ", 1))
        return kiri, kanan
    return "", teks


def parse_lrc(teks: str) -> list[tuple[float, str]]:
    """Ubah LRC menjadi daftar (detik, baris), terurut."""
    baris: list[tuple[float, str]] = []
    for row in (teks or "").splitlines():
        stempel = re.findall(r"\[(\d+):(\d+(?:[.:]\d+)?)\]", row)
        if not stempel:
            continue
        isi = re.sub(r"\[[^\]]*\]", "", row).strip()
        for menit, detik in stempel:
            baris.append((int(menit) * 60 + float(detik.replace(":", ".")), isi))
    return sorted(baris, key=lambda x: x[0])


def fetch_lyrics(judul: str, artis: str = "", durasi: float = 0.0) -> dict:
    """Ambil lirik dari LRCLIB, utamakan yang tersinkron.

    LRCLIB terbuka dan tidak menuntut kunci API. Hasilnya disimpan — termasuk
    hasil "tidak ada", karena mengulang pencarian yang sudah pasti gagal cuma
    menambah jeda tiap kali lagunya diputar lagi.

    Kalau beberapa entri cocok, yang durasinya paling dekat dengan lagu inilah
    yang dipilih: satu judul sering punya banyak versi dengan panjang berbeda,
    dan stempel waktu dari versi yang salah akan meleset sepanjang lagu.
    """
    import hashlib
    import urllib.parse
    import urllib.request

    kunci = hashlib.sha1(f"{judul}|{artis}|{int(durasi)}".encode()).hexdigest()[:16]
    berkas = LYRICS_CACHE / f"{kunci}.json"
    try:
        return json.loads(berkas.read_text())
    except (OSError, json.JSONDecodeError):
        pass

    a, t = bersihkan_judul(judul)
    if artis:
        a = artis
    kueri = " ".join(x for x in (a, t) if x) or judul
    hasil: dict = {"synced": [], "plain": "", "judul": "", "artis": "", "ada": False}
    try:
        req = urllib.request.Request(
            "https://lrclib.net/api/search?q=" + urllib.parse.quote(kueri),
            headers={"User-Agent": "musicbox (pemutar musik TUI)"})
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.loads(resp.read().decode("utf-8", "replace"))
    except Exception:
        data = []

    kandidat = [d for d in data if d.get("syncedLyrics") or d.get("plainLyrics")]
    if kandidat:
        def jarak(d):
            # Yang tersinkron selalu menang atas yang polos, baru soal durasi.
            return (0 if d.get("syncedLyrics") else 1,
                    abs((d.get("duration") or 0) - durasi) if durasi else 0)
        pilih = sorted(kandidat, key=jarak)[0]
        hasil = {
            "synced": parse_lrc(pilih.get("syncedLyrics") or ""),
            "plain": pilih.get("plainLyrics") or "",
            "judul": pilih.get("trackName") or "",
            "artis": pilih.get("artistName") or "",
            "ada": True,
        }
    try:
        LYRICS_CACHE.mkdir(parents=True, exist_ok=True)
        berkas.write_text(json.dumps(hasil))
    except OSError:
        pass
    return hasil


def fetch_lyrics_cached_only(judul: str, artis: str = "",
                             durasi: float = 0.0) -> dict | None:
    """Baca lirik dari simpanan saja, tanpa menyentuh jaringan.

    Dipakai di jalur yang berjalan berkali-kali tiap detik — memanggil LRCLIB
    dari sana akan membanjiri layanannya sekaligus membekukan pemanggilnya.
    """
    import hashlib
    kunci = hashlib.sha1(f"{judul}|{artis}|{int(durasi)}".encode()).hexdigest()[:16]
    try:
        return json.loads((LYRICS_CACHE / f"{kunci}.json").read_text())
    except (OSError, json.JSONDecodeError):
        return None


def lyrics_cached(judul: str, artis: str = "", durasi: float = 0.0) -> bool | None:
    """True/False kalau sudah pernah dicari, None kalau belum pernah."""
    import hashlib
    kunci = hashlib.sha1(f"{judul}|{artis}|{int(durasi)}".encode()).hexdigest()[:16]
    try:
        return bool(json.loads((LYRICS_CACHE / f"{kunci}.json").read_text())["ada"])
    except (OSError, json.JSONDecodeError, KeyError):
        return None


