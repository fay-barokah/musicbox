        Binding("right", "seek_fwd", "+5s", show=False),
        Binding("left", "seek_back", "-5s", show=False),
        Binding("plus,equals_sign", "vol_up", "Vol+", show=False),
        Binding("minus", "vol_down", "Vol-", show=False),
        Binding("z", "shuffle", "Acak"),
        Binding("a", "toggle_autoplay", "Autoplay"),
        Binding("c", "toggle_cava", "Visualizer"),
        Binding("d", "download", show=False, description="Unduh"),
        Binding("f", "toggle_format", show=False, description="mp3/opus"),
        Binding("R", "radio", show=False, description="Radio"),
        Binding("x", "delete_track", show=False, description="Hapus"),
        Binding("e", "enqueue", show=False, description="+Antrean"),
        Binding("E", "dequeue", "−Antrean", show=False),
        Binding("ctrl+up", "queue_up", "Naik", show=False),
        Binding("ctrl+down", "queue_down", "Turun", show=False),
        Binding("P", "play_queue", show=False, description="Putar antrean"),
        Binding("S", "new_playlist", "Album baru"),
        Binding("A", "add_to_playlist", show=False, description="+ke album"),
        Binding("X", "delete_playlist", "Hapus album", show=False),
        Binding("D", "remove_from_album", "Hapus dari album", show=False),
        Binding("r", "rescan", "Pindai ulang"),
        Binding("q", "quit", "Keluar"),
    ]

    def __init__(self) -> None:
        super().__init__()
        self.player = MpvPlayer()
        self.library = Library()
        self.autoplay = True
        self.cava_on = True
        self.results: list[dict] = []
        self.dl_format = "mp3"
        self._pending_delete: str | None = None
        self._pending_add: dict | None = None
        self._marked_path: str | None = None
        self.image_ok = True
        self.downloads: list[dict] = []
        self.queue: list[dict] = []
        self.playlists: dict[str, list] = {}
        self._scheme_mtime = 0.0

    # -- tema -------------------------------------------------------------

    def get_css_variables(self) -> dict[str, str]:
        """Suntikkan palet Caelestia sebagai variabel CSS Textual.

        Dipakai lewat $cae-* di CSS di atas. Textual memanggil ini ulang saat
        refresh_css(), jadi ganti wallpaper cukup memicu refresh tanpa restart.
        """
        variables = super().get_css_variables()
        c = load_scheme()

        def col(key: str, fallback: str) -> str:
            return "#" + (c.get(key) or FALLBACK.get(key) or fallback)

        variables.update({
            "cae-surface": col("surface", "1c1c1c"),
            "cae-container": col("surfaceContainer", "262626"),
            "cae-container-high": col("surfaceContainerHigh", "303030"),
            "cae-on-surface": col("onSurface", "e6e6e6"),
            "cae-on-variant": col("onSurfaceVariant", "a8a8a8"),
            "cae-primary": col("primary", "89b4fa"),
            "cae-outline": col("outline", "6c6c6c"),
            "cae-error": col("error", "f38ba8"),
        })
        return variables

    def _watch_scheme(self) -> None:
        try:
            mtime = SCHEME_FILE.stat().st_mtime
        except OSError:
            return
        if mtime != self._scheme_mtime:
            self._scheme_mtime = mtime
            self.refresh_css()

    # -- susunan ----------------------------------------------------------

    def compose(self) -> ComposeResult:
        yield Header(show_clock=True)
        with Vertical():
            with Horizontal(id="main"):
                with TabbedContent(id="tabs"):
                    with TabPane("Library", id="tab-lib"):
                        yield DataTable(id="library", cursor_type="row", zebra_stripes=False)
                    with TabPane("Cari", id="tab-yt"):
                        yield Input(placeholder="cari di YouTube lalu tekan Enter…",
                                    id="yt-input")
                        yield DataTable(id="results", cursor_type="row", zebra_stripes=False)
                    with TabPane("Antrean", id="tab-queue"):
                        yield DataTable(id="queue", cursor_type="row",
                                        zebra_stripes=False)
                    with TabPane("Album", id="tab-pl"):
                        yield Tree("album", id="pltree")  # auto_expand dimatikan di on_mount
                    with TabPane("Unduhan", id="tab-dl"):
                        yield DataTable(id="downloads", cursor_type="row",
                                        zebra_stripes=False)
                with Vertical(id="info"):
                    yield Static(id="cover")
                    yield Static(id="info-text")
                    # Aksi khusus LAGU tinggal di sini, terpisah dari bar bawah
                    # yang khusus kendali PEMUTARAN. Sebelumnya keduanya
                    # bercampur di footer dan sulit dibedakan mana yang mana.
                    yield Vertical(id="song-actions")
            yield CavaBars(id="cava")
            yield NowPlaying()
        yield Footer()

    async def on_mount(self) -> None:
        table = self.query_one("#library", DataTable)
        table.add_columns("Judul", "Artis", "Durasi")
        self.query_one("#results", DataTable).add_columns("Judul", "Kanal", "Durasi")
        self.query_one("#downloads", DataTable).add_columns("Judul", "Format", "Status", "Waktu")
        self.query_one("#queue", DataTable).add_columns("#", "Judul", "Sumber")
        # Enter pada node album jangan ikut melipatnya: album yang menutup
        # membuat pemutaran terlihat seperti tidak terjadi apa-apa.
        self.query_one("#pltree", Tree).auto_expand = False
        self.load_downloads()
        self.load_queue()
        self.load_playlists()
        self.load_library()

        await self.player.start()
        self.player.on_update = self._schedule_refresh

        await self.restore_resume()

        self.set_interval(0.5, self.refresh_now_playing)
        self.set_interval(2.0, self._watch_scheme)
        try:
            self._scheme_mtime = SCHEME_FILE.stat().st_mtime
        except OSError:
            pass

    def _schedule_refresh(self) -> None:
        # Dipanggil dari task pembaca IPC; jadwalkan di loop UI.
        self.call_later(self.refresh_now_playing)

    # -- data -------------------------------------------------------------

    def load_library(self, force: bool = False) -> None:
        table = self.query_one("#library", DataTable)
        table.clear()
        tracks = self.library.scan(force=force)
        for t in tracks:
            table.add_row(t["title"], t["artist"] or "—", fmt_time(t["duration"]))
        self.sub_title = f"library — {len(tracks)} lagu"
        if not tracks:
            self.notify(f"{MUSIC_DIR} kosong. Unduh dengan: music -d \"judul\"",
                        severity="warning", timeout=8)

    def _mark_now_playing(self, path: str | None) -> None:
        """Tandai baris yang sedang berbunyi di semua daftar.

        Tanpa ini posisi pemutaran hanya terbaca di bar bawah — saat album
        berisi banyak lagu, tidak ada cara melihat sedang di lagu mana.
        """
        marker = "▶ "
        try:
            table = self.query_one("#library", DataTable)
            for i, t in enumerate(self.library.tracks):
                label = (marker if t["path"] == path else "  ") + t["title"]
                table.update_cell_at((i, 0), label, update_width=False)
        except Exception:
            pass
        try:
            table = self.query_one("#queue", DataTable)
            for i, q in enumerate(self.queue):
                label = (marker if q.get("target") == path else "  ") + q.get("title", "?")
                table.update_cell_at((i, 1), label, update_width=False)
        except Exception:
            pass
        try:
            tree = self.query_one("#pltree", Tree)
            for node in tree.root.children:
                for leaf in node.children:
                    it = (leaf.data or {}).get("item") or {}
                    mark = marker if it.get("target") == path else "  "
                    leaf.set_label(mark + it.get("title", "?"))
        except Exception:
            pass

    def refresh_now_playing(self) -> None:
        st = self.player.state
        # Penanda hanya digambar ulang saat lagunya benar-benar berganti,
        # bukan tiap setengah detik.
        path = st.get("path")
        if path != self._marked_path:
            self._marked_path = path
            self._mark_now_playing(path)
        title = st.get("title") or "tidak ada yang diputar"
        if st.get("pause") and st.get("path"):
            title = f"⏸  {title}"
        elif st.get("path"):
            title = f"▶  {title}"
        # Timer 0,5 detik ini terus berdetak sampai aplikasi benar-benar mati,
        # termasuk sesaat setelah widget dilepas saat keluar. Tanpa penjaga di
        # sini query_one melempar NoMatches dan aplikasi crash ketika ditutup.
        try:
            self.query_one("#np-title", Static).update(title)
            pos = st.get("time-pos") or 0.0
            dur = st.get("duration") or 0.0
            self.query_one("#np-elapsed", Static).update(fmt_time(pos))
            self.query_one("#np-total", Static).update(fmt_time(dur))
            self.query_one("#np-bar", SeekBar).position = (pos / dur) if dur else 0.0
        # Volume disinkronkan dari mpv, bukan hanya diset saat diklik — tanpa
        # ini bar-nya tidak pernah bergerak walau volumenya benar-benar berubah
        # (mis. lewat tombol +/- atau saat mpv baru mulai).
            self.query_one("#vol-bar", VolumeBar).level = (st.get("volume") or 0) / 130.0
        except Exception:
            return

    async def on_seek_bar_seek(self, message: SeekBar.Seek) -> None:
        await self.player.seek_fraction(message.fraction)

    # -- aksi -------------------------------------------------------------

    # -- pencarian YouTube -------------------------------------------------

    async def on_input_submitted(self, event: Input.Submitted) -> None:
        query = event.value.strip()
        if not query:
            return
        self.notify("mencari…", timeout=2)
        # yt-dlp butuh belasan detik; dijalankan di thread supaya UI tidak beku.
        self.run_worker(lambda: yt_search(query), thread=True,
                        name="ytsearch", group="yt", exit_on_error=False)

    def on_worker_state_changed(self, event) -> None:
        from textual.worker import WorkerState

        if event.state is not WorkerState.SUCCESS:
            return
        if event.worker.name == "thumb":
            vid, path = event.worker.result or (None, None)
            # Abaikan kalau kursor sudah pindah ke lagu lain sejak unduhan mulai.
            cur = self._selected_result()
            if path and cur and cur["id"] == vid:
                self.show_cover(path)
            return
        if event.worker.name != "ytsearch":
            return
        self.results = event.worker.result or []
        table = self.query_one("#results", DataTable)
        table.clear()
        for r in self.results:
            table.add_row(r["title"], r["uploader"], r["duration"])
        self.notify(f"{len(self.results)} hasil" if self.results else "tidak ada hasil",
                    timeout=2)

    # -- panel info --------------------------------------------------------

    # Peta tab -> tabel isinya, dipakai agar panel info hanya mengikuti tab
    # yang sedang dibuka.
    TAB_TABLE = {"tab-lib": "library", "tab-yt": "results",
                 "tab-queue": "queue", "tab-dl": "downloads",
                 "tab-pl": "album"}

    # Aksi yang hanya masuk akal di tab tertentu. Selain yang terdaftar di
    # sini, aksi dianggap global (kendali pemutaran, keluar, dan sejenisnya).
    TAB_ACTIONS = {
        "tab-lib":   {"delete_track", "enqueue", "rescan", "shuffle",
                      "add_to_playlist"},
        "tab-yt":    {"download", "toggle_format", "radio", "enqueue",
                      "add_to_playlist"},
        "tab-queue": {"dequeue", "queue_up", "queue_down", "play_queue",
                      "add_to_playlist"},
        "tab-pl":    {"new_playlist", "delete_playlist", "remove_from_album",
                      "add_to_playlist"},
        "tab-dl":    set(),
    }
    CONTEXTUAL = set().union(*TAB_ACTIONS.values())

    def check_action(self, action: str, parameters) -> bool | None:
        """Sembunyikan aksi yang tidak relevan dengan tab yang sedang dibuka.

        Footer Textual membaca hasil fungsi ini, jadi daftar tombol di bawah
        ikut berubah per tab alih-alih menampilkan semuanya sekaligus.
        """
        if action not in self.CONTEXTUAL:
            return True
        try:
            active = self.query_one("#tabs", TabbedContent).active
        except Exception:
            return True
        return action in self.TAB_ACTIONS.get(active, set())

    def _active_table(self) -> str | None:
        try:
            return self.TAB_TABLE.get(self.query_one("#tabs", TabbedContent).active)
        except Exception:
            return None

    def on_data_table_row_highlighted(self, event: DataTable.RowHighlighted) -> None:
        # Tabel yang tidak terlihat tetap memancarkan event saat isinya
        # berubah; tanpa saringan ini panel info bisa menampilkan lagu dari
        # tab lain — misalnya rincian library padahal sedang di tab Unduhan.
        if event.data_table.id != self._active_table():
            return
        self.update_info(event.data_table.id, event.cursor_row)

    def on_tree_node_highlighted(self, event) -> None:
        self.rebuild_song_actions("album")
        self.update_album_info(event.node)

    def update_album_info(self, node) -> None:
        info = self.query_one("#info-text", Static)
        data = getattr(node, "data", None) or {}
        name = data.get("playlist")
        if not name:
            info.update("[dim]pilih album atau lagu di dalamnya[/dim]")
            self.show_cover(None)
            return
        if "item" in data:
            it = data["item"]
            target = it.get("target", "")
            self.show_cover(extract_cover(Path(target)) if not target.startswith("http") else None)
            info.update("\n".join([
                f"[b]{it.get('title', '?')}[/b]", "",
                f"album    {name}",
                f"sumber   {it.get('source', '?')}",
                "", f"[dim]{target}[/dim]",
            ]))
        else:
            items = self.playlists.get(name, [])
            self.show_cover(None)
            info.update("\n".join([
                f"[b]{name}[/b]", "",
                f"lagu     {len(items)}",
                "", "[dim]enter putar semua[/dim]",
            ]))

    def on_tabbed_content_tab_activated(self, event) -> None:
        table_id = self._active_table()
        if table_id == "album":
            self.rebuild_song_actions("album")
            self.update_album_info(self.query_one("#pltree", Tree).cursor_node)
            return
        if not table_id:
            return
        try:
            table = self.query_one(f"#{table_id}", DataTable)
        except Exception:
            return
        self.update_info(table_id, table.cursor_row)

    def show_cover(self, image_path: Path | None) -> None:
        """Tampilkan sampul di panel kanan.

        Widget gambar dibuat ulang tiap kali, bukan diganti sumbernya: cara itu
        paling andal di terminal, karena renderer sixel menggambar di luar
        kanvas Textual dan sisa gambar lama bisa tertinggal.
        """
        holder = self.query_one("#cover", Static)
        holder.remove_children()
        if not image_path or not self.image_ok:
            holder.display = False
            return
        try:
            # SixelImage dipaksa, bukan AutoImage. Deteksi otomatis di
            # textual-image jatuh ke renderer blok Unicode di terminal ini —
            # hasilnya kotak-kotak kasar, bukan foto. foot mendukung sixel
            # (grafik sungguhan), jadi renderer itu dipilih langsung dan
            # AutoImage hanya dipakai sebagai cadangan.
            try:
                from textual_image.widget import SixelImage as ImageWidget
            except ImportError:
                from textual_image.widget import Image as ImageWidget

            holder.display = True
            holder.mount(ImageWidget(str(image_path)))
        except Exception:
            # Terminal tanpa dukungan gambar tidak boleh membuat aplikasi mati;
            # panel cukup kembali ke teks saja.
            holder.display = False
            self.image_ok = False

    # Aksi lagu per konteks: (label, nama aksi). Ditaruh di panel kanan, bukan
    # di footer, supaya jelas mana yang bekerja pada LAGU dan mana yang pada
    # PEMUTARAN.
    SONG_ACTIONS = {
        "library":   [("▶  putar", "play_selected"), ("＋ antrean", "enqueue"),
                      ("♪  album", "add_to_playlist"), ("✕  hapus file", "delete_track")],
        "results":   [("▶  putar", "play_selected"), ("📻 radio", "radio"),
                      ("＋ antrean", "enqueue"), ("♪  album", "add_to_playlist"),
                      ("⬇  unduh", "download")],
        "queue":     [("▶  putar antrean", "play_queue"), ("♪  album", "add_to_playlist"),
                      ("✕  keluarkan", "dequeue")],
        # Tab Album memakai Tree, bukan DataTable. Tanpa entri sendiri di sini
        # panel kanan membeku menampilkan aksi tab sebelumnya, dan aksi
        # "keluarkan dari album" tidak pernah muncul sama sekali.
        "album":     [("▶  putar", "play_selected"),
                      ("✕  keluarkan dari album", "remove_from_album"),
                      ("🗑  hapus album", "delete_playlist")],
        "downloads": [],
    }

    def rebuild_song_actions(self, table_id: str | None) -> None:
        box = self.query_one("#song-actions", Vertical)
        box.remove_children()
        for label, action in self.SONG_ACTIONS.get(table_id or "", []):
            box.mount(TransportButton(label, action, classes="song-act"))

    async def action_play_selected(self) -> None:
        """Putar lagu yang sedang disorot, dari tab mana pun."""
        song = self._selected_song()
        if song:
            await self.player.play(song["target"])

    def update_info(self, table_id: str, idx: int) -> None:
        """Isi panel kanan sesuai baris yang sedang disorot."""
        info = self.query_one("#info-text", Static)
        self.rebuild_song_actions(table_id)
        lines: list[str] = []
        if table_id == "library" and 0 <= idx < len(self.library.tracks):
            t = self.library.tracks[idx]
            p = Path(t["path"])
            size = p.stat().st_size / 1e6 if p.exists() else 0
            self.show_cover(extract_cover(p))
            lines = [
                f"[b]{t['title']}[/b]", "",
                f"artis    {t['artist'] or '—'}",
                f"durasi   {fmt_time(t['duration'])}",
                f"format   {p.suffix.lstrip('.') or '—'}",
                f"ukuran   {size:.1f} MB",
                "", f"[dim]{p.name}[/dim]",
            ]
        elif table_id == "results" and 0 <= idx < len(self.results):
            r = self.results[idx]
            # Thumbnail diunduh di thread supaya UI tidak beku saat menyorot
            # cepat-cepat melewati daftar hasil.
            vid = r["id"]
            self.run_worker(lambda: (vid, fetch_thumbnail(vid)), thread=True,
                            name="thumb", group="thumb", exit_on_error=False)
            lines = [
                f"[b]{r['title']}[/b]", "",
                f"kanal    {r['uploader']}",
                f"durasi   {r['duration']}",
                "", f"[dim]{yt_url(r['id'])}[/dim]",
                "", "[dim]enter putar · d unduh · R radio[/dim]",
            ]
        elif table_id == "downloads" and 0 <= idx < len(self.downloads):
            d = self.downloads[idx]
            lines = [
                f"[b]{d.get('title', '?')}[/b]", "",
                f"format   {d.get('format', '?')}",
                f"status   {d.get('status', '?')}",
                f"waktu    {d.get('time', '?')}",
                "", f"[dim]{d.get('url', '')}[/dim]",
            ]
        info.update("\n".join(lines))

    # -- antrean -----------------------------------------------------------

    def load_queue(self) -> None:
        try:
            self.queue = json.loads(QUEUE_FILE.read_text())
        except (OSError, json.JSONDecodeError):
            self.queue = []
        self.refresh_queue_table()

    def save_queue(self) -> None:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        try:
            QUEUE_FILE.write_text(json.dumps(self.queue, indent=1))
        except OSError:
            pass

    def refresh_queue_table(self) -> None:
        table = self.query_one("#queue", DataTable)
        keep = table.cursor_row
        table.clear()
        for i, q in enumerate(self.queue, 1):
            table.add_row(str(i), q.get("title", "?"), q.get("source", "lokal"))
        if 0 <= keep < len(self.queue):
            table.move_cursor(row=keep)

    def enqueue(self, title: str, target: str, source: str = "lokal") -> None:
        self.queue.append({"title": title, "target": target, "source": source})
        self.save_queue()
        self.refresh_queue_table()
        self.notify(f"antrean +1 ({len(self.queue)})", timeout=2)

    def action_enqueue(self) -> None:
        """Tambah baris yang sedang disorot ke antrean."""
        active = self._active_table()
        if active == "library":
            idx = self.query_one("#library", DataTable).cursor_row
            if 0 <= idx < len(self.library.tracks):
                t = self.library.tracks[idx]
                item = {"title": t["title"], "target": t["path"], "source": "lokal"}
                self._pending_add = item
                self.enqueue(**item)
        elif active == "results":
            r = self._selected_result()
            if r:
                item = {"title": r["title"], "target": yt_url(r["id"]),
                        "source": "youtube"}
                self._pending_add = item
                self.enqueue(**item)
        else:
            self.notify("pilih dari Library atau Cari", timeout=3)

    def action_dequeue(self) -> None:
        if self._active_table() != "queue":
            return
        idx = self.query_one("#queue", DataTable).cursor_row
        if 0 <= idx < len(self.queue):
            self.queue.pop(idx)
            self.save_queue()
            self.refresh_queue_table()

    def _move_in_queue(self, delta: int) -> None:
        if self._active_table() != "queue":
            return
        table = self.query_one("#queue", DataTable)
        i = table.cursor_row
        j = i + delta
        if 0 <= i < len(self.queue) and 0 <= j < len(self.queue):
            self.queue[i], self.queue[j] = self.queue[j], self.queue[i]
            self.save_queue()
            self.refresh_queue_table()
            table.move_cursor(row=j)

    def action_queue_up(self) -> None:
        self._move_in_queue(-1)

    def action_queue_down(self) -> None:
        self._move_in_queue(1)

    async def action_play_queue(self, loop: bool = False) -> None:
        """Putar antrean dari awal, sisanya diantrekan ke playlist mpv."""
        if not self.queue:
            self.notify("antrean kosong", timeout=2)
            return
        await self.player.set_loop(loop)
        await self.player.play(self.queue[0]["target"])
        for q in self.queue[1:]:
            await self.player.append(q["target"])
        self.notify(f"memutar {len(self.queue)} lagu" + (" · diulang" if loop else ""),
                    timeout=2)

    # -- playlist tersimpan ------------------------------------------------

    def load_playlists(self) -> None:
        """Muat semua playlist dan gambarkan sebagai tree.

        Bentuk tree dipilih karena satu playlist berisi banyak lagu — daftar
        datar akan mencampur nama playlist dengan isinya. Node induk bisa
        dilipat, persis seperti pohon berkas di editor kode.
        """
        PLAYLIST_DIR.mkdir(parents=True, exist_ok=True)
        self.playlists = {}
        for f in sorted(PLAYLIST_DIR.glob("*.json")):
            try:
                self.playlists[f.stem] = json.loads(f.read_text())
            except (OSError, json.JSONDecodeError):
                continue

        tree = self.query_one("#pltree", Tree)
        tree.clear()
        tree.root.label = f"album ({len(self.playlists)})"
        tree.root.expand()
        for name, items in self.playlists.items():
            node = tree.root.add(f"{name}  ({len(items)})", data={"playlist": name})
            for it in items:
                node.add_leaf(it.get("title", "?"),
                              data={"playlist": name, "item": it})
            # Dibentangkan sejak awal: album yang terlipat menyembunyikan isinya
            # sehingga lagunya tidak bisa disorot maupun dikeluarkan.
            node.expand()

    def action_new_playlist(self) -> None:
        """Buat playlist baru yang kosong.

        Alurnya sengaja begini, bukan "simpan antrean sebagai playlist": kamu
        membuat wadahnya dulu, lalu mengisinya lagu per lagu dari Library atau
        Cari. Itu lebih dekat dengan cara orang menyusun playlist.
        """
        self.push_screen(PlaylistNameScreen(), self._do_new_playlist)

    def _do_new_playlist(self, name: str | None) -> str | None:
        if not name:
            return None
        # Nama file dibersihkan: hanya huruf, angka, spasi, strip.
        safe = "".join(c for c in name if c.isalnum() or c in " -_").strip()
        if not safe:
            self.notify("nama tidak valid", severity="error", timeout=3)
            return None
        target = PLAYLIST_DIR / f"{safe}.json"
        if target.exists():
            self.notify("nama sudah dipakai", severity="warning", timeout=3)
            return None
        PLAYLIST_DIR.mkdir(parents=True, exist_ok=True)
        try:
            target.write_text("[]")
        except OSError as exc:
            self.notify(f"gagal buat: {exc}", severity="error", timeout=4)
            return None
        self.load_playlists()
        self.notify(f"album '{safe}' dibuat", timeout=3)
        return safe

    def _current_playlist(self) -> str | None:
        node = self.query_one("#pltree", Tree).cursor_node
        return node.data.get("playlist") if node and node.data else None

    def _selected_song(self) -> dict | None:
        """Lagu yang sedang disorot, dari tab mana pun yang aktif."""
        active = self._active_table()
        if active == "library":
            idx = self.query_one("#library", DataTable).cursor_row
            if 0 <= idx < len(self.library.tracks):
                t = self.library.tracks[idx]
                return {"title": t["title"], "target": t["path"], "source": "lokal"}
        elif active == "results":
            r = self._selected_result()
            if r:
                return {"title": r["title"], "target": yt_url(r["id"]),
                        "source": "youtube"}
        elif active == "queue":
            idx = self.query_one("#queue", DataTable).cursor_row
            if 0 <= idx < len(self.queue):
                return dict(self.queue[idx])
        elif active == "album":
            # Sumbernya Tree, jadi lagu diambil dari node yang disorot.
            node = self.query_one("#pltree", Tree).cursor_node
            data = getattr(node, "data", None) or {}
            if "item" in data:
                return dict(data["item"])
        return None

    def action_add_to_playlist(self) -> None:
        """Tambahkan lagu yang disorot ke album — pilih tujuannya lewat dialog."""
        song = self._selected_song()
        if not song:
            self.notify("sorot lagu di Library, Cari, atau Antrean", timeout=4)
            return
        self._pending_add = song
        self.push_screen(AlbumPicker(sorted(self.playlists)), self._add_to_album)

    def _add_to_album(self, name: str | None) -> None:
        if name is None:
            return
        if name == "":
            # Pilihan "buat album baru": rantai ke dialog nama.
            self.push_screen(PlaylistNameScreen(), self._new_album_with_song)
            return
        self._append_to_album(name, self._pending_add)

    def _new_album_with_song(self, name: str | None) -> None:
        created = self._do_new_playlist(name)
        if created:
            self._append_to_album(created, self._pending_add)

    def _append_to_album(self, name: str, item: dict | None) -> None:
        if not item:
            return
        items = list(self.playlists.get(name, []))
        # Tolak duplikat: satu lagu cukup sekali dalam satu album. Tanpa ini
        # menekan tambah dua kali menghasilkan entri kembar yang membingungkan
        # saat diputar maupun dikeluarkan.
        if any(i.get("target") == item.get("target") for i in items):
            self.notify(f"sudah ada di '{name}'", severity="warning", timeout=3)
            return
        items.append(item)
        try:
            (PLAYLIST_DIR / f"{name}.json").write_text(json.dumps(items, indent=1))
        except OSError as exc:
            self.notify(f"gagal simpan: {exc}", severity="error", timeout=4)
            return
        self.load_playlists()
        self.notify(f"+1 ke '{name}'", timeout=2)

    def action_remove_from_album(self) -> None:
        """Hapus satu lagu dari album (daun yang disorot di tree)."""
        node = self.query_one("#pltree", Tree).cursor_node
        if not node or not node.data or "item" not in node.data:
            self.notify("sorot lagunya di dalam album", timeout=3)
            return
        name = node.data["playlist"]
        target = node.data["item"].get("target")
        items = [i for i in self.playlists.get(name, []) if i.get("target") != target]
        try:
            (PLAYLIST_DIR / f"{name}.json").write_text(json.dumps(items, indent=1))
        except OSError as exc:
            self.notify(f"gagal simpan: {exc}", severity="error", timeout=4)
            return
        self.load_playlists()
        self.notify(f"dihapus dari '{name}'", timeout=2)

    def action_delete_playlist(self) -> None:
        node = self.query_one("#pltree", Tree).cursor_node
        if not node or not node.data or "item" in node.data:
            self.notify("pilih nama playlist-nya", timeout=3)
            return
        name = node.data["playlist"]
        if self._pending_delete == f"pl:{name}":
            try:
                (PLAYLIST_DIR / f"{name}.json").unlink()
            except OSError as exc:
                self.notify(f"gagal hapus: {exc}", severity="error", timeout=4)
                return
            self._pending_delete = None
            self.load_playlists()
            self.notify("playlist dihapus", timeout=2)
        else:
            self._pending_delete = f"pl:{name}"
            self.notify("tekan x lagi untuk hapus", timeout=4)
            self.set_timer(4.0, lambda: setattr(self, "_pending_delete", None))

    async def on_tree_node_selected(self, event) -> None:
        data = event.node.data
        if not data:
            return
        if "item" in data:
            # Daun: putar SELURUH album mulai dari lagu ini, bukan lagu itu
            # sendirian. Memuat satu lagu saja membuat mpv tidak punya playlist,
            # sehingga tombol "berikut" tidak punya tujuan dan pemutaran
            # berhenti begitu lagu itu habis.
            name = data["playlist"]
            items = list(self.playlists.get(name, []))
            target = data["item"].get("target")
            start = next((i for i, it in enumerate(items)
                          if it.get("target") == target), 0)
            self.queue = items[start:] + items[:start]
            self.save_queue()
            self.refresh_queue_table()
            await self.action_play_queue(loop=True)
        else:
            # Induk: seluruh playlist dimuat ke antrean lalu diputar.
            self.queue = list(self.playlists.get(data["playlist"], []))
            self.save_queue()
            self.refresh_queue_table()
            # Album diulang terus. Album biasanya pendek; berhenti senyap
            # setelah lagu terakhir terasa seperti pemutarnya mati.
            await self.action_play_queue(loop=True)

    # -- riwayat unduhan ---------------------------------------------------

    def load_downloads(self) -> None:
        try:
            self.downloads = json.loads(DOWNLOADS_LOG.read_text())
        except (OSError, json.JSONDecodeError):
            self.downloads = []
        table = self.query_one("#downloads", DataTable)
        table.clear()
        for d in self.downloads:
            table.add_row(d.get("title", "?"), d.get("format", "?"),
                          d.get("status", "?"), d.get("time", ""))

    def log_download(self, entry: dict) -> None:
        self.downloads.insert(0, entry)
        self.downloads = self.downloads[:100]
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        try:
            DOWNLOADS_LOG.write_text(json.dumps(self.downloads, indent=1))
        except OSError:
            pass
        self.query_one("#queue", DataTable).add_columns("#", "Judul", "Sumber")
        # Enter pada node album jangan ikut melipatnya: album yang menutup
        # membuat pemutaran terlihat seperti tidak terjadi apa-apa.
        self.query_one("#pltree", Tree).auto_expand = False
        self.load_downloads()
        self.load_queue()
        self.load_playlists()

    def _selected_result(self) -> dict | None:
        table = self.query_one("#results", DataTable)
        idx = table.cursor_row
        return self.results[idx] if 0 <= idx < len(self.results) else None

    async def action_download(self) -> None:
        """Unduh hasil terpilih lewat skrip `music`.

        Perintah yt-dlp tidak ditulis ulang di sini: flag di `music -d` sudah
        teruji (mp3/opus, embed sampul & metadata, jebakan ekstensi). Dua
        salinan berarti dua tempat yang bisa menyimpang.
        """
        r = self._selected_result()
        if not r:
            self.notify("pilih hasil pencarian dulu", timeout=3)
            return
        cmd = [str(HOME / ".local/bin/music"), "-d"]
        if self.dl_format == "opus":
            cmd.insert(1, "-o")
        url = yt_url(r["id"])
        cmd.append(url)
        fmt, title = self.dl_format, r["title"]
        self.notify(f"unduh: {fmt}", timeout=3)
        self.log_download({"title": title, "format": fmt, "status": "berjalan",
                           "url": url, "time": time.strftime("%H:%M")})

        def run_and_log() -> int:
            rc = subprocess.run(cmd, capture_output=True, text=True).returncode
            # Perbarui entri paling atas: itu unduhan yang baru saja dijalankan.
            if self.downloads:
                self.downloads[0]["status"] = "selesai" if rc == 0 else "gagal"
                try:
                    DOWNLOADS_LOG.write_text(json.dumps(self.downloads, indent=1))
                except OSError:
                    pass
            return rc

        self.run_worker(run_and_log, thread=True, name="download",
                        group="yt", exit_on_error=False)

    def action_toggle_format(self) -> None:
        self.dl_format = "opus" if self.dl_format == "mp3" else "mp3"
        self.notify(f"format: {self.dl_format}", timeout=2)

    async def action_radio(self) -> None:
        r = self._selected_result()
        if not r:
            self.notify("pilih hasil pencarian dulu", timeout=3)
            return
        await self.player.play(yt_radio_url(r["id"]))
        self.notify("radio dimulai", timeout=2)

    # -- pemutaran ---------------------------------------------------------

    async def on_data_table_row_selected(self, event: DataTable.RowSelected) -> None:
        if event.data_table.id == "results":
            r = self._selected_result()
            if r:
                # Saat autoplay hidup, yang dimuat adalah playlist Mix (list=RD)
                # bukan video tunggal — sehingga tombol "berikut" menyambung ke
                # rekomendasi YouTube, persis seperti YouTube Music.
                await self.player.play(
                    yt_radio_url(r["id"]) if self.autoplay else yt_url(r["id"]))
            return
        idx = event.cursor_row
        if not (0 <= idx < len(self.library.tracks)):
            return
        tracks = self.library.tracks
        await self.player.play(tracks[idx]["path"])
        if self.autoplay:
            # Sisa library diantrekan ke playlist mpv supaya lagu berlanjut
            # sendiri tanpa perlu ditekan apa-apa.
            for t in tracks[idx + 1:] + tracks[:idx]:
                await self.player.append(t["path"])

    async def on_transport_button_pressed(self, message: TransportButton.Pressed) -> None:
        action = message.action
        if action == "pause":
            await self.player.toggle_pause()
        elif action == "next":
            await self.player.next_track()
        elif action == "prev":
            await self.player.prev_track()
        elif action == "stop":
            await self.player.stop()
        elif action == "shuffle":
            await self.action_shuffle()
        elif action == "autoplay":
            self.action_toggle_autoplay()
        elif action == "cava":
            self.action_toggle_cava()
        else:
            # Aksi dari panel kanan (tombol lagu). Dijalankan lewat nama supaya
            # daftar SONG_ACTIONS tetap jadi satu-satunya sumber kebenaran.
            handler = getattr(self, f"action_{action}", None)
            if handler:
                result = handler()
                if asyncio.iscoroutine(result):
                    await result

    async def on_volume_bar_changed(self, message: VolumeBar.Changed) -> None:
        await self.player.set_volume_abs(message.fraction * 130)
        label = self.query_one("#vol-label", Static)
        if message.show:
            label.update(f"{int(message.fraction * 130)}%")
            # Kembalikan ke ikon setelah sesaat supaya bar tetap bersih.
            self.set_timer(1.5, lambda: label.update("🕪"))

    async def action_shuffle(self) -> None:
        tracks = list(self.library.tracks)
        if not tracks:
            return
        random.shuffle(tracks)
        await self.player.play(tracks[0]["path"])
        for t in tracks[1:]:
            await self.player.append(t["path"])
        self.notify("diacak", timeout=2)

    def action_toggle_autoplay(self) -> None:
        self.autoplay = not self.autoplay
        btn = self.query_one("#btn-auto", TransportButton)
        btn.update("↻ auto" if self.autoplay else "↻ off")
        btn.set_class(self.autoplay, "on")
        btn.set_class(not self.autoplay, "off")
        self.notify("autoplay on" if self.autoplay else "autoplay off", timeout=2)

    def action_toggle_cava(self) -> None:
        """Sembunyikan visualizer sekaligus hentikan prosesnya.

        Sekadar menyembunyikan widget tidak cukup — cava tetap jalan dan makan
        ~16 MB. Prosesnya ikut dimatikan supaya benar-benar hemat.
        """
        cava = self.query_one("#cava", CavaBars)
        btn = self.query_one("#btn-cava", TransportButton)
        self.cava_on = not self.cava_on
        cava.display = self.cava_on
        btn.update("◫ cava" if self.cava_on else "◫ off")
        btn.set_class(self.cava_on, "on")
        btn.set_class(not self.cava_on, "off")
        if self.cava_on:
            self.run_worker(cava.restart(), exclusive=False)
        else:
            cava.stop()
        self.notify("cava on" if self.cava_on else "cava off", timeout=2)

    async def action_toggle_pause(self) -> None:
        await self.player.toggle_pause()

    async def action_next(self) -> None:
        await self.player.next_track()

    async def action_prev(self) -> None:
        await self.player.prev_track()

    async def action_stop(self) -> None:
        await self.player.stop()

    async def action_seek_fwd(self) -> None:
        await self.player.seek(5)

    async def action_seek_back(self) -> None:
        await self.player.seek(-5)

    async def action_vol_up(self) -> None:
        await self.player.set_volume(5)

    async def action_vol_down(self) -> None:
        await self.player.set_volume(-5)

    def action_rescan(self) -> None:
        self.load_library(force=True)
        self.notify("library dipindai", timeout=2)

    # -- lanjut dari terakhir ---------------------------------------------

    def save_resume(self) -> None:
        """Simpan lagu dan posisi terakhir supaya bisa dilanjutkan.

        Ditulis saat keluar, bukan berkala, supaya tidak menyentuh disk
        terus-menerus selama memutar.
        """
        st = self.player.state
        path = st.get("path")
        if not path:
            return
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        try:
            RESUME_FILE.write_text(json.dumps({
                "path": path,
                "position": st.get("time-pos") or 0.0,
                "title": st.get("title") or "",
            }))
        except OSError:
            pass

    async def restore_resume(self) -> None:
        try:
            data = json.loads(RESUME_FILE.read_text())
        except (OSError, json.JSONDecodeError):
            return
        path, pos = data.get("path"), data.get("position") or 0.0
        if not path:
            return
        # Sengaja dimuat dalam keadaan JEDA: membuka aplikasi tidak seharusnya
        # langsung mengeluarkan suara. Tekan spasi untuk melanjutkan.
        await self.player.load_paused(path, pos)
        self.notify(f"lanjut: {fmt_time(pos)}", timeout=3)

    def action_delete_track(self) -> None:
        table = self.query_one("#library", DataTable)
        idx = table.cursor_row
        if not (0 <= idx < len(self.library.tracks)):
            return
        track = self.library.tracks[idx]
        if self._pending_delete == track["path"]:
            try:
                Path(track["path"]).unlink()
            except OSError as exc:
                self.notify(f"gagal hapus: {exc}", severity="error", timeout=4)
                return
            self._pending_delete = None
            self.load_library(force=True)
            self.notify("dihapus", timeout=2)
        else:
            # Konfirmasi dua langkah: menghapus file tidak bisa dibatalkan.
            self._pending_delete = track["path"]
            self.notify("tekan x lagi untuk hapus", timeout=4)
            self.set_timer(4.0, lambda: setattr(self, "_pending_delete", None))

    def on_unmount(self) -> None:
        self.save_resume()
        self.player.shutdown()
        try:
            self.query_one("#cava", CavaBars).stop()
        except Exception:
            pass


LOCK_FILE = RUNTIME / "musicbox.lock"


def already_running() -> int | None:
    """Kembalikan PID instans lain yang masih hidup, kalau ada.

    Perlu karena semua instans memakai socket mpv yang sama; instans kedua
    akan menimpa socket milik yang pertama sehingga yang lama kehilangan
    kendali atas pemutarnya. Selain itu dua pemutar akan berebut audio dan
    mendaftarkan MPRIS ganda.
    """
    try:
        pid = int(LOCK_FILE.read_text().strip())
    except (OSError, ValueError):
        return None
    if pid == os.getpid():
        return None
    try:
        # Signal 0 hanya memeriksa keberadaan proses, tidak mengirim apa pun.
        os.kill(pid, 0)
    except (ProcessLookupError, PermissionError):
        return None
    try:
        cmd = Path(f"/proc/{pid}/cmdline").read_bytes().decode(errors="ignore")
    except OSError:
        return None
    return pid if "musicbox" in cmd else None


def main() -> int:
    if shutil.which("mpv") is None:
        print("mpv belum terpasang", flush=True)
        return 1

    other = already_running()
    if other:
        print(f"musicbox sudah berjalan (pid {other}).", flush=True)
        print("Gunakan jendela yang sudah terbuka, atau Super+Alt+M untuk memunculkannya.",
              flush=True)
        return 1

    LOCK_FILE.parent.mkdir(parents=True, exist_ok=True)
    try:
        LOCK_FILE.write_text(str(os.getpid()))
    except OSError:
        pass
    try:
        MusicBox().run()
    finally:
        # Hanya hapus kalau lock ini memang milik kita — mencegah instans lain
        # kehilangan lock-nya saat proses ini berakhir.
        try:
            if LOCK_FILE.read_text().strip() == str(os.getpid()):
                LOCK_FILE.unlink(missing_ok=True)
        except OSError:
            pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
