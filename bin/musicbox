#!/usr/bin/env python3
"""musicbox — pemutar musik TUI.

Dibuat karena menu fzf di `music` berpindah-pindah layar dan tidak bisa diklik
atau di-scroll. Ini panel sungguhan ala btop: layout menyesuaikan ukuran
jendela, mouse jalan, dan warnanya mengikuti skema Caelestia.

Bagian:
  MpvPlayer  — mesin pemutar. mpv dijalankan sekali dalam mode idle lalu
               dikendalikan lewat JSON IPC. Berbeda dari `music` yang meng-exec
               mpv di depan; mode idle memungkinkan kendali penuh dari UI.
  Library    — pindai ~/Music, baca tag dengan mutagen, cache ke JSON.
  MusicBox   — aplikasi Textual.

Unduhan sengaja memanggil `music -d` alih-alih menulis ulang perintah yt-dlp:
flag di sana sudah teruji (mp3 vs opus, embed sampul/metadata, dan jebakan
file .mp3 yang isinya sebenarnya AAC). Dua salinan berarti dua tempat yang
bisa menyimpang.
"""

from __future__ import annotations

import asyncio
import json
import os
import random
import shutil
import subprocess
import time
from pathlib import Path

from textual.app import App, ComposeResult
from textual.binding import Binding
from textual.containers import Horizontal, Vertical
from textual.screen import ModalScreen
from textual.message import Message
from textual.reactive import reactive
from textual.widgets import (DataTable, Footer, Header, Input, Static,
                             TabbedContent, TabPane, Tree)

# ---------------------------------------------------------------- konstanta

HOME = Path.home()
MUSIC_DIR = Path(os.environ.get("MUSIC_DIR", HOME / "Music"))
STATE_DIR = HOME / ".local/share/musicbox"
LIBRARY_CACHE = STATE_DIR / "library.json"
RESUME_FILE = STATE_DIR / "resume.json"
DOWNLOADS_LOG = STATE_DIR / "downloads.json"
QUEUE_FILE = STATE_DIR / "queue.json"
PLAYLIST_DIR = STATE_DIR / "playlists"
SCHEME_FILE = HOME / ".local/state/caelestia/scheme.json"
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
MPV_SOCKET = RUNTIME / "musicbox-mpv.sock"

AUDIO_EXT = {".mp3", ".m4a", ".opus", ".flac", ".ogg", ".oga", ".wav", ".aac", ".wma"}

# Warna cadangan kalau Caelestia belum pernah menghasilkan skema.
FALLBACK = {
    "surface": "1c1c1c", "surfaceContainer": "262626", "surfaceContainerHigh": "303030",
    "onSurface": "e6e6e6", "onSurfaceVariant": "a8a8a8", "primary": "89b4fa",
    "outline": "6c6c6c", "error": "f38ba8",
}


def fmt_time(seconds: float | None) -> str:
    if not seconds or seconds < 0:
        return "--:--"
    seconds = int(seconds)
    h, rem = divmod(seconds, 3600)
    m, s = divmod(rem, 60)
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m}:{s:02d}"


# ------------------------------------------------------------------ pemutar


class MpvPlayer:
    """Bungkus mpv yang berjalan terus dalam mode idle.

    Kenapa idle: proses mpv tetap hidup di antara lagu, jadi status pemutaran
    bisa dipantau dan dikendalikan kapan saja lewat socket. Diverifikasi pada
    mpv v0.41.0 — `idle-active` merespons `true`.
    """

    def __init__(self) -> None:
        self.proc: subprocess.Popen | None = None
        self.reader: asyncio.StreamReader | None = None
        self.writer: asyncio.StreamWriter | None = None
        self.mpris = False
        self._req_id = 0
        self.state: dict = {
            "path": None, "title": None, "pause": True,
            "time-pos": 0.0, "duration": 0.0, "volume": 70.0,
        }
        self.on_update = None  # callback tanpa argumen, dipanggil tiap state berubah

    @staticmethod
    def _mpris_script() -> str | None:
        """Cari plugin mpv-mpris kalau terpasang.

        Tanpa ini musicbox tidak terlihat oleh siapa pun di desktop. Dengan ini
        ia muncul di widget media Caelestia lengkap dengan judul dan kendali —
        `Players.qml:18` bahkan menyebut mpv-mpris secara eksplisit di
        komentarnya, jadi memang sudah diantisipasi.
        """
        for candidate in ("/usr/lib/mpv/mpris.so", "/usr/lib/mpv-mpris/mpris.so",
                          "/usr/share/mpv/scripts/mpris.so"):
            if Path(candidate).exists():
                return candidate
        return None

    async def start(self) -> None:
        MPV_SOCKET.parent.mkdir(parents=True, exist_ok=True)
        MPV_SOCKET.unlink(missing_ok=True)
        args = ["mpv", "--idle=yes", "--no-video", "--really-quiet",
                "--volume=70", f"--input-ipc-server={MPV_SOCKET}",
                # Fallback ke `best` wajib: live stream YouTube tidak punya
                # format audio-only, jadi `bestaudio` sendirian akan gagal.
                "--ytdl-format=bestaudio/best"]
        script = self._mpris_script()
        if script:
            args.append(f"--script={script}")
        self.mpris = bool(script)
        self.proc = subprocess.Popen(
            args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        # Socket dibuat mpv beberapa saat setelah proses hidup.
        for _ in range(100):
            if MPV_SOCKET.exists():
                break
            await asyncio.sleep(0.05)
        self.reader, self.writer = await asyncio.open_unix_connection(str(MPV_SOCKET))
        for prop in ("path", "media-title", "pause", "time-pos", "duration", "volume"):
            await self._send({"command": ["observe_property", 1, prop]})
        asyncio.create_task(self._read_loop())

    async def _send(self, payload: dict) -> None:
        if not self.writer:
            return
        self._req_id += 1
        payload.setdefault("request_id", self._req_id)
        try:
            self.writer.write((json.dumps(payload) + "\n").encode())
            await self.writer.drain()
        except (BrokenPipeError, ConnectionResetError):
            pass

    async def _read_loop(self) -> None:
        assert self.reader
        while True:
            try:
                line = await self.reader.readline()
            except (ConnectionResetError, asyncio.IncompleteReadError):
                break
            if not line:
                break
            try:
                msg = json.loads(line)
            except json.JSONDecodeError:
                continue
            if msg.get("event") == "property-change":
                name, data = msg.get("name"), msg.get("data")
                if name == "media-title":
                    self.state["title"] = data
                elif name in self.state:
                    self.state[name] = data
                if self.on_update:
                    self.on_update()

    # -- perintah ---------------------------------------------------------

    async def play(self, target: str) -> None:
        await self._send({"command": ["loadfile", target, "replace"]})
        await self._send({"command": ["set_property", "pause", False]})

    async def load_paused(self, target: str, position: float = 0.0) -> None:
        """Muat lagu dalam keadaan jeda pada posisi tertentu.

        `start` diberikan sebagai opsi per-file supaya mpv langsung membuka di
        posisi itu, bukan memutar dari awal lalu melompat.
        """
        opts = {"pause": "yes"}
        if position > 1:
            opts["start"] = str(int(position))
        await self._send({"command": ["loadfile", target, "replace", -1, opts]})

    async def append(self, target: str) -> None:
        await self._send({"command": ["loadfile", target, "append-play"]})

    async def toggle_pause(self) -> None:
        await self._send({"command": ["cycle", "pause"]})

    async def next_track(self) -> None:
        await self._send({"command": ["playlist-next", "force"]})

    async def prev_track(self) -> None:
        await self._send({"command": ["playlist-prev", "force"]})

    async def stop(self) -> None:
        await self._send({"command": ["stop"]})

    async def seek(self, delta: int) -> None:
        await self._send({"command": ["seek", delta, "relative"]})

    async def set_loop(self, enabled: bool) -> None:
        await self._send({"command": ["set_property", "loop-playlist",
                                      "inf" if enabled else "no"]})

    async def seek_fraction(self, frac: float) -> None:
        """Lompat ke posisi 0..1 dari durasi. Dipakai saat bar diklik."""
        await self._send({"command": ["seek", max(0.0, min(1.0, frac)) * 100,
                                      "absolute-percent"]})

    async def set_volume(self, delta: int) -> None:
        vol = max(0, min(130, (self.state.get("volume") or 70) + delta))
        await self._send({"command": ["set_property", "volume", vol]})

    async def set_volume_abs(self, vol: float) -> None:
        await self._send({"command": ["set_property", "volume",
                                      max(0.0, min(130.0, vol))]})

    def shutdown(self) -> None:
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()
        MPV_SOCKET.unlink(missing_ok=True)


# ------------------------------------------------------------------ library


class Library:
    """Daftar lagu di ~/Music beserta tag-nya.

    Hasil pindaian di-cache supaya start berikutnya tidak membaca ulang semua
    file. Cache dianggap basi kalau mtime direktori berubah.
    """

    def __init__(self) -> None:
        self.tracks: list[dict] = []

    def scan(self, force: bool = False) -> list[dict]:
        if not MUSIC_DIR.is_dir():
            self.tracks = []
            return self.tracks
        dir_mtime = MUSIC_DIR.stat().st_mtime
        if not force and LIBRARY_CACHE.exists():
            try:
                cached = json.loads(LIBRARY_CACHE.read_text())
                if cached.get("mtime") == dir_mtime:
                    self.tracks = cached["tracks"]
                    return self.tracks
            except (json.JSONDecodeError, KeyError, OSError):
                pass

        tracks = []
        for f in sorted(MUSIC_DIR.iterdir()):
            if not f.is_file() or f.suffix.lower() not in AUDIO_EXT:
                continue
            tracks.append(self._read_tags(f))
        self.tracks = tracks
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        LIBRARY_CACHE.write_text(json.dumps({"mtime": dir_mtime, "tracks": tracks}))
        return tracks

    @staticmethod
    def _read_tags(path: Path) -> dict:
        title, artist, dur = path.stem, "", 0.0
        try:
            from mutagen import File as MutagenFile

            m = MutagenFile(path, easy=True)
            if m is not None:
                if m.info is not None:
                    dur = float(getattr(m.info, "length", 0.0) or 0.0)
                title = (m.get("title") or [title])[0]
                artist = (m.get("artist") or [""])[0]
        except Exception:
            # Tag rusak atau format tak dikenal bukan alasan menyembunyikan
            # lagunya — tampilkan apa adanya dengan nama file.
            pass
        return {"path": str(path), "title": title, "artist": artist, "duration": dur}


# ------------------------------------------------------------------- sampul

COVER_CACHE = STATE_DIR / "covers"


def extract_cover(path: Path) -> Path | None:
    """Ambil sampul yang tertanam di file audio.

    mutagen menyimpan gambar di tempat berbeda tergantung format: APIC untuk
    ID3 (mp3), `covr` untuk MP4/M4A, dan `pictures` untuk FLAC/Opus. Ketiganya
    ditangani supaya semua file di ~/Music punya peluang menampilkan sampul.
    """
    COVER_CACHE.mkdir(parents=True, exist_ok=True)
    out = COVER_CACHE / (str(abs(hash(str(path)))) + ".png")
    if out.exists():
        return out
    try:
        from mutagen import File as MutagenFile

        audio = MutagenFile(path)
        if audio is None:
            return None
        data = None
        tags = getattr(audio, "tags", None)
        if tags is not None:
            for key in tags.keys():
                if key.startswith("APIC"):
                    data = tags[key].data
                    break
            if data is None and "covr" in tags:
                covr = tags["covr"]
                data = bytes(covr[0]) if covr else None
        if data is None:
            pics = getattr(audio, "pictures", None)
            if pics:
                data = pics[0].data
        if data is None and tags is not None and "metadata_block_picture" in tags:
            # Ogg/Opus menyimpan sampul sebagai blok Picture FLAC yang
            # di-base64 di dalam Vorbis comment — bukan APIC maupun .pictures.
            # Tanpa cabang ini semua unduhan format opus kehilangan sampulnya.
            import base64

            from mutagen.flac import Picture

            for blob in tags["metadata_block_picture"]:
                try:
                    data = Picture(base64.b64decode(blob)).data
                    break
                except Exception:
                    continue
        if not data:
            return None
        out.write_bytes(data)
        return out
    except Exception:
        return None


def fetch_thumbnail(video_id: str) -> Path | None:
    """Unduh thumbnail YouTube. Ukuran mq sudah cukup untuk panel selebar 36."""
    COVER_CACHE.mkdir(parents=True, exist_ok=True)
    out = COVER_CACHE / f"yt-{video_id}.jpg"
    if out.exists():
        return out
    try:
        subprocess.run(
            ["curl", "-sL", "--max-time", "15", "-o", str(out),
             f"https://i.ytimg.com/vi/{video_id}/mqdefault.jpg"],
            check=True, capture_output=True, timeout=20)
        return out if out.exists() and out.stat().st_size > 0 else None
    except (OSError, subprocess.SubprocessError):
        return None


# ------------------------------------------------------------------ youtube


def yt_search(query: str, limit: int = 20) -> list[dict]:
    """Cari lagu di YouTube lewat yt-dlp.

    Format --print memakai TAB SUNGGUHAN: `yt-dlp --print` tidak menafsirkan
    "\\t" dan akan mencetaknya sebagai dua huruf literal. Sama persis dengan
    pick_video() di skrip `music`.
    """
    tab = "\t"
    fmt = tab.join(("%(id)s", "%(duration>%H:%M:%S)s", "%(uploader).24s", "%(title).80s"))
    try:
        out = subprocess.run(
            ["yt-dlp", "--skip-download", "--no-warnings", "--flat-playlist",
             "--print", fmt, f"ytsearch{limit}:{query}"],
            capture_output=True, text=True, timeout=180,
        ).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    results = []
    for line in out.splitlines():
        parts = line.split(tab)
        if len(parts) == 4:
            results.append({"id": parts[0], "duration": parts[1],
                            "uploader": parts[2], "title": parts[3]})
    return results


def yt_url(video_id: str) -> str:
    return f"https://www.youtube.com/watch?v={video_id}"


def yt_radio_url(video_id: str) -> str:
    """Playlist Mix YouTube — rekomendasi berantai, ratusan lagu."""
    return f"https://www.youtube.com/watch?v={video_id}&list=RD{video_id}"


# -------------------------------------------------------------------- tema


def load_scheme() -> dict:
    """Ambil palet Caelestia. Kunci Material You, 120 warna."""
    try:
        return json.loads(SCHEME_FILE.read_text()).get("colours", {}) or FALLBACK
    except (OSError, json.JSONDecodeError):
        return FALLBACK


# --------------------------------------------------------------- aplikasi


class SeekBar(Static):
    """Bar posisi yang bisa diklik dan diseret.

    ProgressBar bawaan Textual tidak punya handler mouse sama sekali, jadi
    dibuat sendiri: render manual, lalu terjemahkan koordinat x klik menjadi
    fraksi durasi.
    """

    position: reactive[float] = reactive(0.0)

    class Seek(Message):
        def __init__(self, fraction: float) -> None:
            self.fraction = fraction
            super().__init__()

    def render(self) -> str:
        width = max(1, self.size.width)
        filled = int(width * max(0.0, min(1.0, self.position)))
        if filled >= width:
            return "━" * width
        return "━" * filled + "╸" + "─" * (width - filled - 1)

    def _emit(self, x: int) -> None:
        self.post_message(self.Seek(x / max(1, self.size.width)))

    def on_click(self, event) -> None:
        self._emit(event.x)

    def on_mouse_down(self, event) -> None:
        self.capture_mouse()

    def on_mouse_move(self, event) -> None:
        # Hanya saat tombol ditekan — seret untuk menggeser posisi.
        if self.app.mouse_captured is self and event.button:
            self._emit(event.x)

    def on_mouse_up(self, event) -> None:
        self.release_mouse()


class CavaBars(Static):
    """Visualizer yang membaca keluaran mentah cava.

    cava dijalankan dengan config sementara ber-output `raw` ascii ke stdout,
    lalu barisnya dibaca dan digambar sebagai balok. Sengaja tidak menulis
    ulang analisis FFT — cava sudah melakukannya, dan warnanya pun sudah
    otomatis mengikuti skema Caelestia lewat apply_cava() di theme.py.
    """

    BLOCKS = " ▁▂▃▄▅▆▇█"
    # Tinggi dalam baris. Satu baris terasa sempit dan gerakannya tidak
    # terbaca; beberapa baris memberi ruang seperti visualizer Caelestia.
    ROWS = 7
    # Nilai mentah cava dipetakan ke ROWS*8 level supaya tiap baris punya
    # delapan tingkat blok — geraknya jadi halus, bukan melompat.
    LEVELS = ROWS * 8

    def __init__(self, bars: int = 40, **kwargs) -> None:
        super().__init__(**kwargs)
        self.bars = bars
        self.values: list[int] = [0] * bars
        self.proc: asyncio.subprocess.Process | None = None
        self._cfg: Path | None = None

    async def on_mount(self) -> None:
        if shutil.which("cava") is None:
            self.update("cava belum terpasang")
            return
        await self._start()

    async def _start(self) -> None:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        self._cfg = STATE_DIR / "cava-raw.conf"
        # ascii_max_range disamakan dengan jumlah level blok supaya nilai bisa
        # dipetakan langsung tanpa penskalaan tambahan.
        self._cfg.write_text(
            "[general]\n"
            "framerate = 30\n"
            f"bars = {self.bars}\n"
            "[output]\n"
            "method = raw\n"
            "raw_target = /dev/stdout\n"
            "data_format = ascii\n"
            f"ascii_max_range = {self.LEVELS}\n"
        )
        try:
            self.proc = await asyncio.create_subprocess_exec(
                "cava", "-p", str(self._cfg),
                stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL,
            )
        except OSError:
            self.update("cava gagal dijalankan")
            return
        asyncio.create_task(self._read_loop())

    async def _read_loop(self) -> None:
        assert self.proc and self.proc.stdout
        while True:
            try:
                line = await self.proc.stdout.readline()
            except (asyncio.IncompleteReadError, ValueError):
                break
            if not line:
                break
            parts = line.decode(errors="ignore").strip().rstrip(";").split(";")
            try:
                self.values = [int(p) for p in parts if p != ""]
            except ValueError:
                continue
            self.refresh()

    def render(self) -> str:
        """Gambar balok vertikal setinggi ROWS baris.

        Tiap bar diberi jarak satu kolom supaya terbaca sebagai balok terpisah,
        bukan dinding rapat. Jumlah bar dihitung dari lebar widget sehingga
        layout tetap benar saat jendela diubah ukurannya.
        """
        if not self.values:
            return "\n" * (self.ROWS - 1)
        width = max(1, self.size.width)
        slots = max(1, (width + 1) // 2)  # satu kolom bar, satu kolom spasi

        vals = self.values
        if len(vals) != slots:
            step = len(vals) / slots
            vals = [vals[min(len(vals) - 1, int(i * step))] for i in range(slots)]

        lines = []
        for row in range(self.ROWS - 1, -1, -1):
            floor_ = row * 8
            cells = []
            for v in vals:
                level = max(0, min(self.LEVELS, v)) - floor_
                if level <= 0:
                    cells.append(" ")
                elif level >= 8:
                    cells.append("█")
                else:
                    cells.append(self.BLOCKS[level])
            lines.append(" ".join(cells))
        return "\n".join(lines)

    def stop(self) -> None:
        if self.proc and self.proc.returncode is None:
            self.proc.terminate()
        self.proc = None

    async def restart(self) -> None:
        self.stop()
        await self._start()


class VolumeBar(Static):
    """Slider volume, sama mekanismenya dengan SeekBar."""

    level: reactive[float] = reactive(0.7)

    class Changed(Message):
        def __init__(self, fraction: float, show: bool = False) -> None:
            self.fraction = fraction
            self.show = show  # tampilkan angka persen (dipakai saat scroll)
            super().__init__()

    def render(self) -> str:
        width = max(1, self.size.width)
        filled = int(width * max(0.0, min(1.0, self.level)))
        return "━" * filled + "─" * (width - filled)

    def _emit(self, x: int) -> None:
        self.post_message(self.Changed(x / max(1, self.size.width)))

    def on_click(self, event) -> None:
        self._emit(event.x)

    def on_mouse_down(self, event) -> None:
        self.capture_mouse()

    def on_mouse_move(self, event) -> None:
        if self.app.mouse_captured is self and event.button:
            self._emit(event.x)

    def on_mouse_up(self, event) -> None:
        self.release_mouse()

    # Scroll di atas bar untuk mengatur volume. Angka persennya hanya muncul
    # saat digulir lalu hilang sendiri, supaya bar tetap bersih saat diam.
    def on_mouse_scroll_up(self, event) -> None:
        event.stop()
        self.post_message(self.Changed(min(1.0, self.level + 0.05), show=True))

    def on_mouse_scroll_down(self, event) -> None:
        event.stop()
        self.post_message(self.Changed(max(0.0, self.level - 0.05), show=True))


class TransportButton(Static):
    """Ikon kendali yang bisa diklik.

    Dipakai alih-alih Button bawaan Textual: Button membawa border dan padding
    sendiri yang membuat baris kendali terlihat berat, sedangkan yang dicari
    adalah ikon polos seperti pemutar musik pada umumnya.
    """

    class Pressed(Message):
        def __init__(self, action: str) -> None:
            self.action = action
            super().__init__()

    def __init__(self, glyph: str, action: str, **kwargs) -> None:
        super().__init__(glyph, **kwargs)
        self.action_name = action

    def on_click(self) -> None:
        self.post_message(self.Pressed(self.action_name))


class NowPlaying(Static):
    """Bar bawah: judul, kendali, waktu, dan posisi yang bisa diklik."""

    def compose(self) -> ComposeResult:
        yield Static("tidak ada yang diputar", id="np-title")
        with Horizontal(id="np-controls"):
            yield TransportButton("⏮", "prev", classes="tbtn")
            yield TransportButton("⏸", "pause", id="btn-pause", classes="tbtn")
            yield TransportButton("⏭", "next", classes="tbtn")
            yield TransportButton("⏹", "stop", classes="tbtn")
            yield TransportButton("⇄", "shuffle", classes="tbtn")
            # Label tombol status ikut berubah, bukan cuma warnanya, supaya
            # kondisi hidup/mati terbaca tanpa harus menebak dari warna.
            yield TransportButton("↻ auto", "autoplay", id="btn-auto", classes="tbtn wide on")
            yield TransportButton("◫ cava", "cava", id="btn-cava", classes="tbtn wide on")
            yield Static("🕪", id="vol-label")
            yield VolumeBar(id="vol-bar")
        with Horizontal(id="np-row"):
            yield Static("--:--", id="np-elapsed")
            yield SeekBar(id="np-bar")
            yield Static("--:--", id="np-total")


class PlaylistNameScreen(ModalScreen[str | None]):
    """Dialog kecil untuk memberi nama album."""

    BINDINGS = [Binding("escape", "cancel", "Batal")]

    def compose(self) -> ComposeResult:
        with Vertical(id="dialog"):
            yield Static("Nama album baru")
            yield Input(placeholder="mis. santai malam", id="pl-name")

    def on_mount(self) -> None:
        self.query_one("#pl-name", Input).focus()

    def on_input_submitted(self, event: Input.Submitted) -> None:
        event.stop()
        self.dismiss(event.value.strip() or None)

    def action_cancel(self) -> None:
        self.dismiss(None)


class AlbumPicker(ModalScreen[str | None]):
    """Pilih album tujuan, atau buat baru.

    Sebelumnya menambahkan lagu ke album mengharuskan pindah tab dan menyorot
    albumnya dulu — dua langkah terpisah yang mudah salah. Dialog ini muncul
    langsung dari Library/Cari sehingga alurnya satu tarikan napas.
    """

    BINDINGS = [Binding("escape", "cancel", "Batal")]

    def __init__(self, albums: list[str]) -> None:
        super().__init__()
        self.albums = albums

    def compose(self) -> ComposeResult:
        with Vertical(id="dialog"):
            yield Static("Tambahkan ke album")
            table = DataTable(id="album-pick", cursor_type="row")
            yield table

    def on_mount(self) -> None:
        table = self.query_one("#album-pick", DataTable)
        table.add_columns("Album")
        table.add_row("＋ buat album baru")
        for a in self.albums:
            table.add_row(a)
        table.focus()

    def on_data_table_row_selected(self, event: DataTable.RowSelected) -> None:
        idx = event.cursor_row
        # Baris 0 selalu "buat baru"; sisanya indeks album dikurangi satu.
        self.dismiss("" if idx == 0 else self.albums[idx - 1])

    def action_cancel(self) -> None:
        self.dismiss(None)


class MusicBox(App):
    TITLE = "musicbox"
    SUB_TITLE = "library"

    # Tema bawaan Textual (`textual-dark`) mengecat latar dengan warna solid,
