    def action_cancel(self) -> None:
        self.dismiss(None)


class LyricsView(Static):
    """Lirik yang bergulir mengikuti lagu.

    Yang ditampilkan hanya jendela di sekitar baris yang sedang berbunyi.
    Menggulirkan seluruh teks lalu menyorot satu baris terasa jauh lebih
    gelisah daripada menahan baris aktif tetap di tengah.
    """

    def __init__(self, **kwargs) -> None:
        super().__init__(**kwargs)
        self.lirik: list[tuple[float, str]] = []
        self.polos = ""
        self.pesan = "mencari lirik…"
        self.idx = -1
        self._tinggi_terakhir = 12

    def set_lyrics(self, data: dict) -> None:
        self.lirik = [(float(t), s) for t, s in (data.get("synced") or [])]
        self.polos = data.get("plain") or ""
        if not self.lirik and not self.polos:
            self.pesan = ("lirik tidak ditemukan\n\n"
                          "[dim]judul unduhan dari YouTube sering\n"
                          "membawa embel-embel yang membuat\n"
                          "pencarian meleset[/dim]")
        self.idx = -1
        self.refresh()

    def sync(self, posisi: float) -> None:
        """Pilih baris yang sedang berbunyi pada detik ini."""
        if not self.lirik:
            return
        baru = -1
        for i, (t, _) in enumerate(self.lirik):
            if t <= posisi:
                baru = i
            else:
                break
        if baru != self.idx:
            self.idx = baru
            self.refresh()

    def render(self) -> str:
        if not self.lirik:
            return self.polos or self.pesan
        # Tinggi 0 terjadi sesaat setelah layar dipasang atau diubah ukurannya.
        # Kalau dipakai apa adanya, tidak ada satu baris pun yang digambar dan
        # liriknya terlihat lenyap padahal datanya utuh.
        tinggi = self.size.height or self._tinggi_terakhir
        tinggi = max(3, tinggi)
        self._tinggi_terakhir = tinggi

        # Baris aktif ditahan tepat di tengah dengan cara mengisi kekurangan di
        # atas dan di bawah memakai baris kosong. Tanpa bantalan itu, sorotan
        # merangkak dari atas ke tengah di awal lagu lalu merangkak lagi ke
        # bawah di akhir — persis yang membuatnya terasa tidak tenang.
        tengah = tinggi // 2
        keluar = []
        for offset in range(-tengah, tinggi - tengah):
            i = self.idx + offset
            if i < 0 or i >= len(self.lirik):
                keluar.append("")
                continue
            teks = self.lirik[i][1] or "♪"
            keluar.append(f"[b]▸ {teks}[/b]" if offset == 0 else f"[dim]  {teks}[/dim]")
        return "\n".join(keluar)


class PlayerScreen(ModalScreen[None]):
    """Halaman pemutar penuh: sampul besar, judul, dan lirik.

    Setara dengan layar "now playing" di Spotify — tempat menikmati satu lagu,
    bukan menjelajah daftar. Karena itu tidak ada tabel di sini sama sekali.
    """

    BINDINGS = [
        Binding("escape", "close", _("Back")),
        Binding("q", "close", _("Back")),
        Binding("space", "playpause", _("Play/Pause")),
        Binding("n", "next", _("Next")),
        Binding("p", "prev", _("Previous")),
        Binding("left", "mundur", "-5s"),
        Binding("right", "maju", "+5s"),
    ]

    def compose(self) -> ComposeResult:
        with Vertical(id="layar-player"):
            with Horizontal(id="player-atas"):
                yield Static(id="player-cover")
                with Vertical(id="player-info"):
                    yield Static(id="player-judul")
                    yield Static(id="player-artis")
                    yield Static(id="player-sumber")
            yield LyricsView(id="player-lirik")
            yield Static(id="player-waktu")
            yield Static("[dim]esc kembali · space main/jeda · n/p lagu · "
                         "←/→ geser 5 detik[/dim]", id="player-bantuan")

    def on_mount(self) -> None:
        self.set_interval(0.3, self._tick)
        self.app.call_after_refresh(self._muat)

    def _muat(self) -> None:
        app = self.app
        info = app.now_playing_info()
        st = app.player.state
        judul = info.get("title") or st.get("title") or _("nothing playing")
        self.query_one("#player-judul", Static).update(f"[b]{judul}[/b]")
        self.query_one("#player-artis", Static).update(info.get("artist") or "—")
        sumber = st.get("path") or ""
        self.query_one("#player-sumber", Static).update(
            f"[dim]{Path(sumber).name if not str(sumber).startswith('http') else sumber}[/dim]")
        gambar = info.get("art")
        holder = self.query_one("#player-cover", Static)
        holder.remove_children()
        if gambar and app.image_ok:
            try:
                try:
                    from textual_image.widget import SixelImage as ImageWidget
                except ImportError:
                    from textual_image.widget import Image as ImageWidget
                holder.mount(ImageWidget(Path(gambar)))
            except Exception:
                pass
        app.minta_lirik(self)

    def _tick(self) -> None:
        st = self.app.player.state
        pos = st.get("time-pos") or 0.0
        dur = st.get("duration") or 0.0
        try:
            lebar = 40
            isi = int(lebar * (pos / dur)) if dur else 0
            bar = "━" * isi + "─" * (lebar - isi)
            tanda = "⏸" if st.get("pause") else "▶"
            self.query_one("#player-waktu", Static).update(
                f"{tanda}  {fmt_time(pos)}  {bar}  {fmt_time(dur)}")
            self.query_one("#player-lirik", LyricsView).sync(pos)
        except Exception:
            pass

    def action_close(self) -> None:
        self.dismiss(None)

    async def action_playpause(self) -> None:
        await self.app.player.toggle_pause()

    async def action_next(self) -> None:
        await self.app.player.next_track()
        self.app.call_after_refresh(self._muat)

    async def action_prev(self) -> None:
        await self.app.player.prev_track()
        self.app.call_after_refresh(self._muat)

    async def action_mundur(self) -> None:
        await self.app.player.seek(-5)

    async def action_maju(self) -> None:
        await self.app.player.seek(5)


class SettingRow(Static):
    """Satu baris setelan yang bisa diklik: label di kiri, nilai di kanan."""

    class Ubah(Message):
        def __init__(self, kunci: str) -> None:
            self.kunci = kunci
            super().__init__()

    def __init__(self, kunci: str, label: str, nilai: str,
                 bisa_diubah: bool = True, **kwargs) -> None:
        super().__init__(**kwargs)
        self.kunci = kunci
        self.label = label
        self.nilai = nilai
        self.bisa_diubah = bisa_diubah
        if bisa_diubah:
            self.add_class("bisa")

    def render(self) -> str:
        # Titik-titik penghubung dipakai supaya mata bisa menyusuri dari nama
        # setelan ke nilainya tanpa tersesat, sekalipun panelnya melebar.
        lebar = max(20, (self.size.width or 46) - 2)
        isi = f"{self.label}  "
        kanan = f"  {self.nilai}"
        titik = "·" * max(1, lebar - len(isi) - len(kanan))
        return f"{isi}[dim]{titik}[/dim]{kanan}"

    def on_click(self) -> None:
        if self.bisa_diubah:
            self.post_message(self.Ubah(self.kunci))


class SettingsScreen(ModalScreen[None]):
    """Setelan, dikelompokkan.

    Satu daftar panjang akan terus memanjang tiap kali ada opsi baru, dan
    opsi yang jarang dipakai ikut menghalangi yang sering. Kategori di kiri
    membuat penambahan berikutnya masuk ke kelompoknya, bukan ke ujung bawah.
    """

    BINDINGS = [
        Binding("escape", "close", _("Back")),
        Binding("q", "close", _("Back")),
        Binding("enter", "ubah", _("Change")),
    ]

    KATEGORI = ["Appearance", "Language", "Playback", "Controls", "About"]

    def __init__(self, kategori: str = "Appearance") -> None:
        super().__init__()
        self.kategori = kategori

    def compose(self) -> ComposeResult:
        with Vertical(id="setel-kotak"):
            yield Static(f"⚙  {_('Settings')}", id="setel-judul")
            with Horizontal(id="setel-isi"):
                with Vertical(id="setel-nav"):
                    for k in self.KATEGORI:
                        yield SettingRow(f"nav:{k}", _(k), "", id=f"nav-{k}",
                                         classes="nav")
                with Vertical(id="setel-opsi"):
                    pass
            yield Static(f"[dim]enter {_('Change')} · esc {_('Back')}[/dim]",
                         id="setel-bantuan")

    def on_mount(self) -> None:
        self._gambar()

    # -- isi tiap kategori --------------------------------------------------

    def _opsi(self) -> list[tuple[str, str, str, bool]]:
        app = self.app
        k = self.kategori
        if k == "Appearance":
            return [
                ("cava", _("Visualizer"), _("on") if app.cava_on else _("off"), True),
                ("zoom", _("Density"),
                 _(("compact", "normal", "roomy")[app.zoom]), True),
                ("palette", _("Palette"),
                 _("follows wallpaper") if SCHEME_FILE.exists() else _("built-in"),
                 False),
            ]
        if k == "Language":
            return [("lang", _("Language"),
                     "English" if _BAHASA == "en" else "Indonesia", True)]
        if k == "Playback":
            return [
                ("autoplay", _("Autoplay"),
                 _("on") if app.autoplay else _("off"), True),
                ("format", _("Download format"), app.dl_format, True),
            ]
        if k == "Controls":
            # Dibaca dari BINDINGS aplikasi, bukan daftar tulisan tangan:
            # daftar terpisah pasti menyimpang begitu ada keybind yang berubah.
            baris = []
            for b in app.BINDINGS:
                if not b.description:
                    continue
                tombol = b.key.replace("question_mark", "?").replace("comma", ",")
                tombol = tombol.replace("equals_sign", "=").replace("plus", "+")
                tombol = tombol.replace("minus", "-").replace("space", "space")
                baris.append((f"key:{b.key}", b.description, tombol, False))
            return baris
        return [
            ("v", "musicbox", "1.0", False),
            ("cfg", _("Settings file"), str(STATE_DIR).replace(str(HOME), "~"), False),
            ("lyr", _("Lyrics source"), "lrclib.net", False),
            ("mpris", "MPRIS", _("on") if getattr(app, "mpris", None)
             and app.mpris.aktif else _("off"), False),
        ]

    def _gambar(self) -> None:
        for k in self.KATEGORI:
            self.query_one(f"#nav-{k}").set_class(k == self.kategori, "terpilih")
        kotak = self.query_one("#setel-opsi", Vertical)
        kotak.remove_children()
        for kunci, label, nilai, bisa in self._opsi():
            kotak.mount(SettingRow(kunci, label, nilai, bisa, classes="opsi"))

    # -- interaksi -----------------------------------------------------------

    async def on_setting_row_ubah(self, pesan: SettingRow.Ubah) -> None:
        await self._terapkan(pesan.kunci)

    async def action_ubah(self) -> None:
        pass

    async def _terapkan(self, kunci: str) -> None:
        app = self.app
        if kunci.startswith("nav:"):
            self.kategori = kunci[4:]
            self._gambar()
            return
        if kunci == "cava":
            app.action_toggle_cava()
        elif kunci == "zoom":
            app._zoom(1 if app.zoom < 2 else -2)
        elif kunci == "lang":
            app.action_bahasa()
        elif kunci == "autoplay":
            app.action_toggle_autoplay()
        elif kunci == "format":
            app.action_toggle_format()
        elif kunci == "help":
            self.dismiss(None)
            app.action_help()
            return
        self._gambar()

    def action_close(self) -> None:
        self.dismiss(None)


class AlbumPicker(ModalScreen[str | None]):
    """Pilih album tujuan, atau buat baru.

    Sebelumnya menambahkan lagu ke album mengharuskan pindah tab dan menyorot
    albumnya dulu — dua langkah terpisah yang mudah salah. Dialog ini muncul
    langsung dari Library/Cari sehingga alurnya satu tarikan napas.
    """

    BINDINGS = [Binding("escape", "cancel", _("Cancel"))]

    def __init__(self, albums: list[str]) -> None:
        super().__init__()
        self.albums = albums

    def compose(self) -> ComposeResult:
        with Vertical(id="dialog"):
            yield Static("Tambahkan ke album")
            table = DataTable(id="album-pick", cursor_type="row")
            yield table

    def on_mount(self) -> None:
        table = self.query_one("#album-pick", DataTable)
        table.add_columns("Album")
        table.add_row("＋ buat album baru")
        for a in self.albums:
            table.add_row(a)
        table.focus()

    def on_data_table_row_selected(self, event: DataTable.RowSelected) -> None:
        idx = event.cursor_row
        # Baris 0 selalu "buat baru"; sisanya indeks album dikurangi satu.
        self.dismiss("" if idx == 0 else self.albums[idx - 1])

    def action_cancel(self) -> None:
        self.dismiss(None)


